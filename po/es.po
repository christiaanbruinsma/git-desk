"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Easy to start. Powerful enough to stay."
msgstr "Easy to start. Powerful enough to stay."

msgid "Git Desk"
msgstr "Git Desk"

msgid "https://github.com/owner/repository.git"
msgstr "https://github.com/owner/repository.git"

msgid "Clone Repository"
msgstr "Clonar repositorio"

msgid "Enter a Git repository URL. Git Desk will then ask where to create the cloned repository."
msgstr "Introduce la URL de un repositorio Git. Git Desk te preguntará después dónde crear el repositorio clonado."

msgid "Cancel"
msgstr "Cancelar"

msgid "Continue"
msgstr "Continuar"

msgid "Choose Location for Cloned Repository"
msgstr "Elegir ubicación del repositorio clonado"

msgid "Choose Project Folder"
msgstr "Elegir carpeta del proyecto"

msgid "Open Project"
msgstr "Abrir proyecto"

msgid "project"
msgstr "proyecto"

msgid "Project folder not found"
msgstr "No se encontró la carpeta del proyecto"

msgid "Remove from Recent Projects"
msgstr "Quitar de proyectos recientes"

msgid "Locate Project…"
msgstr "Localizar proyecto…"

msgid "Locate Project"
msgstr "Localizar proyecto"

msgid "Close"
msgstr "Cerrar"

msgid "Git Desk can’t find {name} at its saved location. The folder may have been moved or deleted."
msgstr "Git Desk no encuentra {name} en la ubicación guardada. Es posible que la carpeta se haya movido o eliminado."

msgid "No textual diff available."
msgstr "No hay diff de texto disponible."

msgid "Repository"
msgstr "Repositorio"

msgid "Back to projects"
msgstr "Volver a proyectos"

msgid "Local project folder"
msgstr "Carpeta de proyecto local"

msgid "Open Repository Folder"
msgstr "Abrir carpeta del repositorio"

msgid "Refresh repository"
msgstr "Actualizar repositorio"

msgid "Push"
msgstr "Push"

msgid "Pull"
msgstr "Pull"

msgid "Fetch"
msgstr "Fetch"

msgid "Inspector"
msgstr "Inspector"

msgid "Select an item to inspect it."
msgstr "Selecciona un elemento para inspeccionarlo."

msgid "Edit Message…"
msgstr "Editar mensaje…"

msgid "Change the message of this unpublished commit without including staged changes."
msgstr "Cambia el mensaje de este commit no publicado sin incluir los cambios preparados."

msgid "Amend"
msgstr "Amend"

msgid "Add all currently staged changes to this unpublished commit."
msgstr "Añade todos los cambios preparados actualmente a este commit no publicado."

msgid "Undo Commit"
msgstr "Deshacer commit"

msgid "Remove this unpublished commit from the branch and return its contents to staging."
msgstr "Elimina este commit no publicado de la rama y devuelve su contenido al área de preparación."

msgid "Revert Commit…"
msgstr "Revertir commit…"

msgid "Create a new commit that reverses this commit on the current branch."
msgstr "Crea un nuevo commit que revierta este commit en la rama actual."

msgid "Cherry-pick…"
msgstr "Cherry-pick…"

msgid "Apply this commit on top of the current branch as a new commit."
msgstr "Aplica este commit sobre la rama actual como un nuevo commit."

msgid "Nothing selected"
msgstr "Nada seleccionado"

msgid "Select a change, commit, branch, stash, or tag to inspect its details."
msgstr "Selecciona un cambio, commit, rama, stash o tag para ver sus detalles."

msgid "Apply"
msgstr "Aplicar"

msgid "Apply this stash to the working tree and keep it in the stash list."
msgstr "Aplica este stash al árbol de trabajo y consérvalo en la lista de stashes."

msgid "Pop"
msgstr "Pop"

msgid "Apply this stash and remove it from the stash list when successful."
msgstr "Aplica este stash y elimínalo de la lista si la operación se completa correctamente."

msgid "Delete Stash"
msgstr "Eliminar stash"

msgid "Permanently remove this saved stash without applying it."
msgstr "Elimina permanentemente este stash guardado sin aplicarlo."

msgid "Push Tag…"
msgstr "Enviar tag…"

msgid "Push exactly this tag to one configured remote without force-updating an existing remote tag."
msgstr "Envía únicamente esta etiqueta a un remoto configurado sin forzar la actualización de una etiqueta remota existente."

msgid "Delete Tag…"
msgstr "Eliminar tag…"

msgid "Delete this local tag. Tags already present on remotes are not deleted."
msgstr "Elimina esta etiqueta local. Las etiquetas que ya existen en remotos no se eliminan."

msgid "Expand Inspector"
msgstr "Ampliar inspector"

msgid "Restore Inspector Width"
msgstr "Restaurar ancho del inspector"

msgid "Could Not Open Repository Folder"
msgstr "No se pudo abrir la carpeta del repositorio"

msgid "Could Not Open Files"
msgstr "No se pudieron abrir los archivos"

msgid "Working tree clean"
msgstr "Árbol de trabajo limpio"

msgid "Resolve conflicted files individually before staging all changes."
msgstr "Resuelve individualmente los archivos en conflicto antes de preparar todos los cambios."

msgid "Stage all working-tree changes"
msgstr "Preparar todos los cambios"

msgid "Conflict · resolve the file, then mark resolved"
msgstr "Conflicto · resuelve el archivo y márcalo como resuelto"

msgid "Unstage"
msgstr "Quitar del stage"

msgid "Mark Resolved"
msgstr "Marcar como resuelto"

msgid "Stage"
msgstr "Preparar"

msgid "Stage this resolved file so Git can continue the current operation."
msgstr "Prepara este archivo resuelto para que Git pueda continuar la operación actual."

msgid "Delete Untracked File…"
msgstr "Eliminar archivo no seguido…"

msgid "Discard Changes…"
msgstr "Descartar cambios…"

msgid "Show Parent Folder in Files"
msgstr "Mostrar carpeta superior en Archivos"

msgid "Show in Files"
msgstr "Mostrar en Archivos"

msgid "Actions"
msgstr "Acciones"

msgid "Change actions"
msgstr "Acciones del cambio"

msgid "This file is not tracked by Git. Deleting it cannot be undone by Git Desk."
msgstr "Git no realiza seguimiento de este archivo. Git Desk no podrá deshacer su eliminación."

msgid "The working-tree version will be restored from Git’s index. Any staged version is kept. This cannot be undone by Git Desk."
msgstr "La versión del árbol de trabajo se restaurará desde el índice de Git. Se conservará cualquier versión preparada. Git Desk no puede deshacer esta acción."

msgid "Delete File"
msgstr "Eliminar archivo"

msgid "Discard Changes"
msgstr "Descartar cambios"

msgid "Ready to commit"
msgstr "Listo para confirmar"

msgid "Working tree"
msgstr "Árbol de trabajo"

msgid "Merge commits require choosing an explicit mainline parent. Git Desk does not guess that parent."
msgstr "Los commits de fusión requieren elegir explícitamente un padre principal. Git Desk no intenta adivinarlo."

msgid "Switch to a normal branch with a clean working tree before applying a history action."
msgstr "Cambia a una rama normal con el árbol de trabajo limpio antes de aplicar una acción del historial."

msgid "Finish or abort the current history operation first."
msgstr "Finaliza o aborta primero la operación de historial actual."

msgid "Create a new commit on the current branch without rewriting existing history."
msgstr "Crea un nuevo commit en la rama actual sin reescribir el historial existente."

msgid "Switch to a normal branch with a clean working tree before cherry-picking a commit."
msgstr "Cambia a una rama normal con el árbol de trabajo limpio antes de hacer cherry-pick de un commit."

msgid "Stage changes first to amend this unpublished commit."
msgstr "Prepara primero cambios para modificar este commit no publicado."

msgid "Could Not Load Commit Message"
msgstr "No se pudo cargar el mensaje del commit"

msgid "Edit Commit Message"
msgstr "Editar mensaje del commit"

msgid "Change the message of this unpublished commit. Currently staged changes will not be included."
msgstr "Cambia el mensaje de este commit no publicado. Los cambios preparados actualmente no se incluirán."

msgid "Save Message"
msgstr "Guardar mensaje"

msgid "Commit message updated"
msgstr "Mensaje del commit actualizado"

msgid "Could Not Edit Commit"
msgstr "No se pudo editar el commit"

msgid "Amend Unpublished Commit?"
msgstr "¿Modificar el commit no publicado?"

msgid "Add all currently staged changes to this commit? Its commit ID will change. Nothing will be pushed automatically."
msgstr "¿Añadir todos los cambios preparados actualmente a este commit? Su ID cambiará. No se enviará nada automáticamente."

msgid "Amend Commit"
msgstr "Modificar commit"

msgid "Staged changes amended into commit"
msgstr "Cambios preparados incorporados al commit"

msgid "Could Not Amend Commit"
msgstr "No se pudo modificar el commit"

msgid "Undo Unpublished Commit?"
msgstr "¿Deshacer el commit no publicado?"

msgid "Remove this commit from the branch and return its contents to the staging area? No files will be deleted. Existing staged changes remain staged."
msgstr "¿Eliminar este commit de la rama y devolver su contenido al área de preparación? No se eliminarán archivos. Los cambios ya preparados seguirán preparados."

msgid "Commit undone — changes returned to staging"
msgstr "Commit deshecho — cambios devueltos al área de preparación"

msgid "Could Not Undo Commit"
msgstr "No se pudo deshacer el commit"

msgid "History Operation Already in Progress"
msgstr "Ya hay una operación de historial en curso"

msgid "Finish or abort the current Revert/Cherry-pick operation in Changes before starting another one."
msgstr "Finaliza o aborta la operación Revert/Cherry-pick actual en Cambios antes de iniciar otra."

msgid "Could Not Check History State"
msgstr "No se pudo comprobar el estado del historial"

msgid "Merge in Progress"
msgstr "Fusión en curso"

msgid "Complete or abort the current merge before applying a history action."
msgstr "Completa o aborta la fusión actual antes de aplicar una acción del historial."

msgid "Could Not Check Merge State"
msgstr "No se pudo comprobar el estado de la fusión"

msgid "Could Not Read Repository Status"
msgstr "No se pudo leer el estado del repositorio"

msgid "Cannot Apply History Action Here"
msgstr "No se puede aplicar una acción del historial aquí"

msgid "Switch to a normal local branch with at least one commit before reverting or cherry-picking."
msgstr "Cambia a una rama local normal con al menos un commit antes de hacer revert o cherry-pick."

msgid "Commit or Stash Changes First"
msgstr "Confirma o guarda primero los cambios en stash"

msgid "Git Desk starts Revert and Cherry-pick from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk inicia Revert y Cherry-pick desde un árbol de trabajo limpio. Confirma tu trabajo o guárdalo en Stashes y vuelve a intentarlo."

msgid "Commit Is Not on the Current Branch"
msgstr "El commit no está en la rama actual"

msgid "Git Desk only reverts commits that are part of the current branch history. Use Cherry-pick when you want to apply a commit from another branch."
msgstr "Git Desk solo revierte commits que forman parte del historial de la rama actual. Usa Cherry-pick para aplicar un commit de otra rama."

msgid "Could Not Verify Commit Ancestry"
msgstr "No se pudo verificar la ascendencia del commit"

msgid "Commit Is Already HEAD"
msgstr "El commit ya es HEAD"

msgid "The selected commit is already the current commit, so there is nothing to cherry-pick."
msgstr "El commit seleccionado ya es el commit actual, así que no hay nada que aplicar mediante cherry-pick."

msgid "Could Not Verify Current Commit"
msgstr "No se pudo verificar el commit actual"

msgid "Revert Commit"
msgstr "Revertir commit"

msgid "Cherry-pick Commit"
msgstr "Cherry-pick del commit"

msgid "Repository Changed"
msgstr "Repositorio modificado"

msgid "The current branch or working tree changed while the confirmation was open. Review the repository and try again."
msgstr "La rama actual o el árbol de trabajo cambió mientras la confirmación estaba abierta. Revisa el repositorio y vuelve a intentarlo."

msgid "Commit reverted"
msgstr "Commit revertido"

msgid "Commit cherry-picked"
msgstr "Commit aplicado con cherry-pick"

msgid "Revert"
msgstr "Revert"

msgid "Abort Revert"
msgstr "Abortar revert"

msgid "Cherry-pick"
msgstr "Cherry-pick"

msgid "Abort Cherry-pick"
msgstr "Abortar cherry-pick"

msgid "History Action Failed"
msgstr "Falló la acción del historial"

msgid "Revert Failed"
msgstr "Revert fallido"

msgid "Cherry-pick Failed"
msgstr "Cherry-pick fallido"

msgid "History Operation Changed"
msgstr "La operación del historial cambió"

msgid "A different history operation is now active. Refresh and review Changes before continuing."
msgstr "Ahora hay otra operación de historial activa. Actualiza y revisa Cambios antes de continuar."

msgid "No History Operation in Progress"
msgstr "No hay ninguna operación de historial en curso"

msgid "There is no Revert or Cherry-pick operation to continue."
msgstr "No hay ninguna operación Revert o Cherry-pick que continuar."

msgid "Could Not Check Conflicts"
msgstr "No se pudieron comprobar los conflictos"

msgid "Conflicts Still Need Resolution"
msgstr "Aún hay conflictos por resolver"

msgid "Stage Remaining Changes"
msgstr "Preparar los cambios restantes"

msgid "Tracked unstaged changes would not be included when the history operation continues. Stage the resolved changes first."
msgstr "Los cambios rastreados no preparados no se incluirían al continuar la operación del historial. Prepara primero los cambios resueltos."

msgid "Revert completed"
msgstr "Reversión completada"

msgid "Cherry-pick completed"
msgstr "Cherry-pick completado"

msgid "Could Not Continue Revert"
msgstr "No se pudo continuar el revert"

msgid "Could Not Continue Cherry-pick"
msgstr "No se pudo continuar el cherry-pick"

msgid "A different history operation is now active. Refresh and review Changes before skipping."
msgstr "Ahora hay otra operación de historial activa. Actualiza y revisa Cambios antes de omitir."

msgid "No Cherry-pick in Progress"
msgstr "No hay ningún cherry-pick en curso"

msgid "There is no Cherry-pick operation to skip."
msgstr "No hay ninguna operación Cherry-pick que omitir."

msgid "Cherry-pick Still Has Conflicts"
msgstr "El cherry-pick aún tiene conflictos"

msgid "Skip is only offered for an empty Cherry-pick. Resolve the conflicts or abort the operation."
msgstr "Omitir solo está disponible para un Cherry-pick vacío. Resuelve los conflictos o aborta la operación."

msgid "Cherry-pick Is No Longer Empty"
msgstr "El cherry-pick ya no está vacío"

msgid "Tracked changes are present. Review and stage the resolution to continue, or abort the Cherry-pick."
msgstr "Hay cambios rastreados. Revisa y prepara la resolución para continuar, o aborta el Cherry-pick."

msgid "Empty Cherry-pick skipped"
msgstr "Cherry-pick vacío omitido"

msgid "Could Not Skip Cherry-pick"
msgstr "No se pudo omitir el cherry-pick"

msgid "Abort Current Revert?"
msgstr "¿Abortar el revert actual?"

msgid "Abort Current Cherry-pick?"
msgstr "¿Abortar el cherry-pick actual?"

msgid "A different history operation is now active. Refresh and review Changes before aborting."
msgstr "Ahora hay otra operación de historial activa. Actualiza y revisa Cambios antes de abortar."

msgid "There is no Revert or Cherry-pick operation to abort."
msgstr "No hay ninguna operación Revert o Cherry-pick que abortar."

msgid "Abort Revert Failed"
msgstr "No se pudo abortar el revert"

msgid "Abort Cherry-pick Failed"
msgstr "No se pudo abortar el cherry-pick"

msgid "Could not load local commits not published to a configured remote."
msgstr "No se pudieron cargar los commits locales no publicados en un remoto configurado."

msgid "Outgoing commits unavailable"
msgstr "Commits salientes no disponibles"

msgid "No commits yet"
msgstr "Aún no hay commits"

msgid "Your first commit will appear here."
msgstr "Tu primer commit aparecerá aquí."

msgid "No changed files."
msgstr "No hay archivos modificados."

msgid "Current branch · merge in progress"
msgstr "Rama actual · fusión en curso"

msgid "Current branch · history operation in progress"
msgstr "Rama actual · operación de historial en curso"

msgid "Current branch · first commit not created yet"
msgstr "Rama actual · aún no se ha creado el primer commit"

msgid "Current branch"
msgstr "Rama actual"

msgid "Remote branch"
msgstr "Rama remota"

msgid "Local branch"
msgstr "Rama local"

msgid "Switch to Branch"
msgstr "Cambiar a la rama"

msgid "Merge into Current Branch…"
msgstr "Fusionar en la rama actual…"

msgid "Abort Merge…"
msgstr "Abortar fusión…"

msgid "Unset Upstream"
msgstr "Quitar upstream"

msgid "Rename Branch…"
msgstr "Renombrar rama…"

msgid "Delete Branch…"
msgstr "Eliminar rama…"

msgid "Branch actions"
msgstr "Acciones de rama"

msgid "Remote branch actions"
msgstr "Acciones de rama remota"

msgid "No local branches yet"
msgstr "Aún no hay ramas locales"

msgid "No remote branches configured"
msgstr "No hay ramas remotas configuradas"

msgid "feature/my-branch"
msgstr "feature/my-branch"

msgid "New Branch"
msgstr "Nueva rama"

msgid "Create a branch from the current branch and switch to it. Uncommitted changes stay in the working tree."
msgstr "Crea una rama desde la rama actual y cambia a ella. Los cambios sin confirmar permanecen en el árbol de trabajo."

msgid "Create & Switch"
msgstr "Crear y cambiar"

msgid "origin/main"
msgstr "origin/main"

msgid "Enter the remote branch this local branch should track, for example origin/main."
msgstr "Introduce la rama remota que debe seguir esta rama local, por ejemplo origin/main."

msgid "Set Upstream"
msgstr "Establecer upstream"

msgid "This repository has uncommitted changes. Git Desk will leave them in the working tree. Git may refuse the switch if the target branch would overwrite them."
msgstr "Este repositorio tiene cambios sin confirmar. Git Desk los dejará en el árbol de trabajo. Git puede rechazar el cambio si la rama de destino los sobrescribiría."

msgid "Switch Branch"
msgstr "Cambiar de rama"

msgid "Continue Revert"
msgstr "Continuar revert"

msgid "Abort Revert…"
msgstr "Abortar revert…"

msgid "Continue Cherry-pick"
msgstr "Continuar cherry-pick"

msgid "Abort Cherry-pick…"
msgstr "Abortar cherry-pick…"

msgid "Finish an empty Cherry-pick without creating a commit."
msgstr "Finaliza un cherry-pick vacío sin crear un commit."

msgid "Continue the current Git history operation using the staged resolution."
msgstr "Continúa la operación actual del historial de Git con la resolución preparada."

msgid "Git Desk must verify the conflict state before continuing."
msgstr "Git Desk debe verificar el estado de los conflictos antes de continuar."

msgid "Git Desk must verify the working tree state before continuing."
msgstr "Git Desk debe verificar el estado del árbol de trabajo antes de continuar."

msgid "Resolve and mark every conflicted file before continuing."
msgstr "Resuelve y marca cada archivo en conflicto antes de continuar."

msgid "There are no tracked changes to commit. Skip the empty Cherry-pick."
msgstr "No hay cambios rastreados para confirmar. Omite el cherry-pick vacío."

msgid "Stage the remaining tracked changes before continuing."
msgstr "Prepara los cambios rastreados restantes antes de continuar."

msgid "Git Desk could not verify the conflict state. Refresh the repository or abort the merge."
msgstr "Git Desk no pudo verificar el estado de los conflictos. Actualiza el repositorio o aborta la fusión."

msgid "Conflicts are resolved, but tracked unstaged changes remain. Stage them before completing the merge."
msgstr "Los conflictos están resueltos, pero quedan cambios rastreados sin preparar. Prepáralos antes de completar la fusión."

msgid "All conflicts are resolved and staged. Complete the merge to create the merge commit."
msgstr "Todos los conflictos están resueltos y preparados. Completa la fusión para crear el commit de fusión."

msgid "Create the merge commit using Git’s prepared merge message."
msgstr "Crea el commit de fusión con el mensaje de fusión preparado por Git."

msgid "Git Desk must verify the conflict state before completing the merge."
msgstr "Git Desk debe verificar el estado de los conflictos antes de completar la fusión."

msgid "Resolve and mark every conflicted file before completing the merge."
msgstr "Resuelve y marca cada archivo en conflicto antes de completar la fusión."

msgid "Stage the remaining tracked changes before completing the merge."
msgstr "Prepara los cambios rastreados restantes antes de completar la fusión."

msgid "No Merge in Progress"
msgstr "No hay ninguna fusión en curso"

msgid "There is no active merge to complete."
msgstr "No hay ninguna fusión activa que completar."

msgid "Tracked unstaged changes would not be included in the merge commit. Stage them first, then complete the merge."
msgstr "Los cambios rastreados sin preparar no se incluirían en el commit de fusión. Prepáralos primero y completa después la fusión."

msgid "Merge completed"
msgstr "Fusión completada"

msgid "Complete Merge Failed"
msgstr "No se pudo completar la fusión"

msgid "Merge Already in Progress"
msgstr "Ya hay una fusión en curso"

msgid "Finish the current merge or abort it before starting another one."
msgstr "Completa la fusión actual o abórtala antes de iniciar otra."

msgid "Cannot Merge Here"
msgstr "No se puede fusionar aquí"

msgid "Check out a normal local branch with at least one commit before merging another branch into it."
msgstr "Cambia a una rama local normal con al menos un commit antes de fusionar otra rama en ella."

msgid "Git Desk only starts a branch merge from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk solo inicia una fusión de ramas desde un árbol de trabajo limpio. Confirma tu trabajo o guárdalo en Stashes y vuelve a intentarlo."

msgid "Git will fast-forward when possible. Otherwise it will create a merge commit. If conflicts occur, Git Desk will keep the merge open so you can resolve the files in Changes or abort the merge from Branches."
msgstr "Git hará fast-forward cuando sea posible. De lo contrario, creará un commit de fusión. Si hay conflictos, Git Desk mantendrá la fusión abierta para que puedas resolver los archivos en Cambios o abortarla desde Ramas."

msgid "Merge Branch"
msgstr "Fusionar rama"

msgid "The current branch or working tree changed while the merge confirmation was open. Review the repository and try again."
msgstr "La rama actual o el árbol de trabajo cambió mientras estaba abierta la confirmación de fusión. Revisa el repositorio y vuelve a intentarlo."

msgid "Merge Failed"
msgstr "Fusión fallida"

msgid "Abort Current Merge?"
msgstr "¿Abortar la fusión actual?"

msgid "Discard the changes created by the current merge attempt and restore the branch to its pre-merge state?"
msgstr "¿Descartar los cambios creados por el intento de fusión actual y restaurar la rama al estado anterior a la fusión?"

msgid "Abort Merge"
msgstr "Abortar fusión"

msgid "There is no active merge to abort."
msgstr "No hay ninguna fusión activa que abortar."

msgid "Merge aborted"
msgstr "Fusión abortada"

msgid "Abort Merge Failed"
msgstr "No se pudo abortar la fusión"

msgid "Rename Branch"
msgstr "Renombrar rama"

msgid "Renaming a branch changes its local name without changing its commits."
msgstr "Cambiar el nombre de una rama modifica su nombre local sin cambiar sus commits."

msgid "Rename"
msgstr "Renombrar"

msgid "This removes the local branch reference. Git Desk uses Git’s safe deletion, so Git will refuse if it considers the branch not fully merged."
msgstr "Esto elimina la referencia de la rama local. Git Desk utiliza la eliminación segura de Git, por lo que Git se negará si considera que la rama no está completamente fusionada."

msgid "Delete Branch"
msgstr "Eliminar rama"

msgid "Type"
msgstr "Tipo"

msgid "Status"
msgstr "Estado"

msgid "Not checked out"
msgstr "No activa"

msgid "Not configured"
msgstr "No configurado"

msgid "Upstream"
msgstr "Upstream"

msgid "origin"
msgstr "origin"

msgid "https://github.com/user/repository.git"
msgstr "https://github.com/user/repository.git"

msgid "Add Remote"
msgstr "Añadir remoto"

msgid "Connect this repository to another Git repository. Enter a remote name and URL."
msgstr "Conecta este repositorio con otro repositorio Git. Introduce un nombre de remoto y una URL."

msgid "Remove Remote…"
msgstr "Eliminar remoto…"

msgid "Remote actions"
msgstr "Acciones del remoto"

msgid "No remotes configured"
msgstr "No hay remotos configurados"

msgid "Add a remote to connect this repository to GitHub, GitLab, Codeberg, or another Git server."
msgstr "Añade un remoto para conectar este repositorio con GitHub, GitLab, Codeberg u otro servidor Git."

msgid "Remove Remote"
msgstr "Eliminar remoto"

msgid "No saved stashes"
msgstr "No hay stashes guardados"

msgid "Loading stash…"
msgstr "Cargando stash…"

msgid "This stash has no visible diff."
msgstr "Este stash no tiene un diff visible."

msgid "Temporarily save staged and working-tree changes."
msgstr "Guarda temporalmente los cambios preparados y los del árbol de trabajo."

msgid "Create the first commit before using Stash."
msgstr "Crea el primer commit antes de usar Stash."

msgid "Optional stash message"
msgstr "Mensaje de stash opcional"

msgid "Include untracked files"
msgstr "Incluir archivos no seguidos"

msgid "Stash Changes"
msgstr "Guardar cambios en stash"

msgid "Temporarily save your current staged and working-tree changes, then return to a clean working tree."
msgstr "Guarda temporalmente los cambios preparados y los del árbol de trabajo y vuelve después a un árbol de trabajo limpio."

msgid "Stash Requires a First Commit"
msgstr "Stash requiere un primer commit"

msgid "Create the repository's first commit before using Stash."
msgstr "Crea el primer commit del repositorio antes de usar Stash."

msgid "Stash created"
msgstr "Stash creado"

msgid "No local changes to stash"
msgstr "No hay cambios locales para guardar"

msgid "Stash Failed"
msgstr "Stash fallido"

msgid "Apply Stash Failed"
msgstr "No se pudo aplicar el stash"

msgid "Pop Stash?"
msgstr "¿Aplicar y quitar el stash?"

msgid "Pop Stash"
msgstr "Aplicar y quitar stash"

msgid "Pop Stash Failed"
msgstr "No se pudo hacer pop del stash"

msgid "Delete Stash?"
msgstr "¿Eliminar stash?"

msgid "Delete Stash Failed"
msgstr "No se pudo eliminar el stash"

msgid "No tags"
msgstr "No hay tags"

msgid "Annotated"
msgstr "Anotado"

msgid "Lightweight"
msgstr "Ligero"

msgid "Annotated tag"
msgstr "Tag anotado"

msgid "Lightweight tag"
msgstr "Tag ligero"

msgid "Target Commit"
msgstr "Commit de destino"

msgid "Nothing to Tag Yet"
msgstr "Aún no hay nada que etiquetar"

msgid "Create the first commit before creating a tag."
msgstr "Crea el primer commit antes de crear una etiqueta."

msgid "Tag name, for example v1.0.0"
msgstr "Nombre de la etiqueta, por ejemplo v1.0.0"

msgid "Optional tag message"
msgstr "Mensaje de tag opcional"

msgid "Add a message for an annotated tag. Leave it blank for a lightweight tag."
msgstr "Añade un mensaje para una etiqueta anotada. Déjalo vacío para una etiqueta ligera."

msgid "Create Tag"
msgstr "Crear tag"

msgid "Create a tag at the current HEAD commit."
