"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Easy to start. Powerful enough to stay."
msgstr "Easy to start. Powerful enough to stay."

msgid "Git Desk"
msgstr "Git Desk"

msgid "https://github.com/owner/repository.git"
msgstr "https://github.com/owner/repository.git"

msgid "Clone Repository"
msgstr "Repository klonen"

msgid "Enter a Git repository URL. Git Desk will then ask where to create the cloned repository."
msgstr "Voer een Git-repository-URL in. Git Desk vraagt daarna waar de gekloonde repository moet worden aangemaakt."

msgid "Cancel"
msgstr "Annuleren"

msgid "Continue"
msgstr "Doorgaan"

msgid "Choose Location for Cloned Repository"
msgstr "Kies locatie voor gekloonde repository"

msgid "Choose Project Folder"
msgstr "Kies projectmap"

msgid "Open Project"
msgstr "Project openen"

msgid "project"
msgstr "project"

msgid "Project folder not found"
msgstr "Projectmap niet gevonden"

msgid "Remove from Recent Projects"
msgstr "Uit Recente projecten verwijderen"

msgid "Locate Project…"
msgstr "Project zoeken…"

msgid "Locate Project"
msgstr "Project zoeken"

msgid "Close"
msgstr "Sluiten"

msgid "Git Desk can’t find {name} at its saved location. The folder may have been moved or deleted."
msgstr "Git Desk kan {name} niet vinden op de opgeslagen locatie. De map is mogelijk verplaatst of verwijderd."

msgid "No textual diff available."
msgstr "Geen tekstuele diff beschikbaar."

msgid "Repository"
msgstr "Repository"

msgid "Back to projects"
msgstr "Terug naar projecten"

msgid "Local project folder"
msgstr "Lokale projectmap"

msgid "Open Repository Folder"
msgstr "Repositorymap openen"

msgid "Refresh repository"
msgstr "Repository vernieuwen"

msgid "Push"
msgstr "Push"

msgid "Pull"
msgstr "Pull"

msgid "Fetch"
msgstr "Fetch"

msgid "Inspector"
msgstr "Inspector"

msgid "Select an item to inspect it."
msgstr "Selecteer een item om het te inspecteren."

msgid "Edit Message…"
msgstr "Bericht bewerken…"

msgid "Change the message of this unpublished commit without including staged changes."
msgstr "Wijzig het bericht van deze niet-gepubliceerde commit zonder staged wijzigingen mee te nemen."

msgid "Amend"
msgstr "Aanvullen"

msgid "Add all currently staged changes to this unpublished commit."
msgstr "Voeg alle huidige staged wijzigingen toe aan deze niet-gepubliceerde commit."

msgid "Undo Commit"
msgstr "Commit ongedaan maken"

msgid "Remove this unpublished commit from the branch and return its contents to staging."
msgstr "Verwijder deze niet-gepubliceerde commit uit de branch en zet de inhoud terug in staging."

msgid "Revert Commit…"
msgstr "Commit terugdraaien…"

msgid "Create a new commit that reverses this commit on the current branch."
msgstr "Maak een nieuwe commit die deze commit op de huidige branch terugdraait."

msgid "Cherry-pick…"
msgstr "Cherry-pick…"

msgid "Apply this commit on top of the current branch as a new commit."
msgstr "Pas deze commit boven op de huidige branch toe als nieuwe commit."

msgid "Nothing selected"
msgstr "Niets geselecteerd"

msgid "Select a change, commit, branch, stash, or tag to inspect its details."
msgstr "Selecteer een wijziging, commit, branch, stash of tag om de details te inspecteren."

msgid "Apply"
msgstr "Toepassen"

msgid "Apply this stash to the working tree and keep it in the stash list."
msgstr "Pas deze stash toe op de working tree en behoud hem in de stashlijst."

msgid "Pop"
msgstr "Pop"

msgid "Apply this stash and remove it from the stash list when successful."
msgstr "Pas deze stash toe en verwijder hem uit de stashlijst wanneer dit slaagt."

msgid "Delete Stash"
msgstr "Stash verwijderen"

msgid "Permanently remove this saved stash without applying it."
msgstr "Verwijder deze opgeslagen stash permanent zonder hem toe te passen."

msgid "Push Tag…"
msgstr "Tag pushen…"

msgid "Push exactly this tag to one configured remote without force-updating an existing remote tag."
msgstr "Push alleen deze tag naar één geconfigureerde remote zonder een bestaande remote tag geforceerd bij te werken."

msgid "Delete Tag…"
msgstr "Tag verwijderen…"

msgid "Delete this local tag. Tags already present on remotes are not deleted."
msgstr "Verwijder deze lokale tag. Tags die al op remotes staan worden niet verwijderd."

msgid "Expand Inspector"
msgstr "Inspector uitklappen"

msgid "Restore Inspector Width"
msgstr "Inspectorbreedte herstellen"

msgid "Could Not Open Repository Folder"
msgstr "Repositorymap kon niet worden geopend"

msgid "Could Not Open Files"
msgstr "Bestanden konden niet worden geopend"

msgid "Working tree clean"
msgstr "Working tree schoon"

msgid "Resolve conflicted files individually before staging all changes."
msgstr "Los conflicterende bestanden afzonderlijk op voordat je alle wijzigingen staged."

msgid "Stage all working-tree changes"
msgstr "Alle wijzigingen stagen"

msgid "Conflict · resolve the file, then mark resolved"
msgstr "Conflict · los het bestand op en markeer het daarna als opgelost"

msgid "Unstage"
msgstr "Unstage"

msgid "Mark Resolved"
msgstr "Markeren als opgelost"

msgid "Stage"
msgstr "Stage"

msgid "Stage this resolved file so Git can continue the current operation."
msgstr "Stage dit opgeloste bestand zodat Git de huidige bewerking kan voortzetten."

msgid "Delete Untracked File…"
msgstr "Niet-gevolgd bestand verwijderen…"

msgid "Discard Changes…"
msgstr "Wijzigingen verwerpen…"

msgid "Show Parent Folder in Files"
msgstr "Bovenliggende map tonen in Bestanden"

msgid "Show in Files"
msgstr "Tonen in Bestanden"

msgid "Actions"
msgstr "Acties"

msgid "Change actions"
msgstr "Acties voor wijziging"

msgid "This file is not tracked by Git. Deleting it cannot be undone by Git Desk."
msgstr "Dit bestand wordt niet door Git gevolgd. Verwijderen kan niet door Git Desk ongedaan worden gemaakt."

msgid "The working-tree version will be restored from Git’s index. Any staged version is kept. This cannot be undone by Git Desk."
msgstr "De versie in de working tree wordt hersteld vanuit de Git-index. Een staged versie blijft behouden. Dit kan niet door Git Desk ongedaan worden gemaakt."

msgid "Delete File"
msgstr "Bestand verwijderen"

msgid "Discard Changes"
msgstr "Wijzigingen verwerpen"

msgid "Ready to commit"
msgstr "Klaar om te committen"

msgid "Working tree"
msgstr "Working tree"

msgid "Merge commits require choosing an explicit mainline parent. Git Desk does not guess that parent."
msgstr "Merge-commits vereisen dat je expliciet een mainline-parent kiest. Git Desk raadt deze parent niet."

msgid "Switch to a normal branch with a clean working tree before applying a history action."
msgstr "Wissel naar een normale branch met een schone working tree voordat je een geschiedenisactie uitvoert."

msgid "Finish or abort the current history operation first."
msgstr "Voltooi of breek eerst de huidige geschiedenisbewerking af."

msgid "Create a new commit on the current branch without rewriting existing history."
msgstr "Maak een nieuwe commit op de huidige branch zonder bestaande geschiedenis te herschrijven."

msgid "Switch to a normal branch with a clean working tree before cherry-picking a commit."
msgstr "Wissel naar een normale branch met een schone working tree voordat je een commit cherry-pickt."

msgid "Stage changes first to amend this unpublished commit."
msgstr "Stage eerst wijzigingen om deze niet-gepubliceerde commit aan te vullen."

msgid "Could Not Load Commit Message"
msgstr "Commitbericht kon niet worden geladen"

msgid "Edit Commit Message"
msgstr "Commitbericht bewerken"

msgid "Change the message of this unpublished commit. Currently staged changes will not be included."
msgstr "Wijzig het bericht van deze niet-gepubliceerde commit. Huidige staged wijzigingen worden niet meegenomen."

msgid "Save Message"
msgstr "Bericht opslaan"

msgid "Commit message updated"
msgstr "Commitbericht bijgewerkt"

msgid "Could Not Edit Commit"
msgstr "Commit kon niet worden bewerkt"

msgid "Amend Unpublished Commit?"
msgstr "Niet-gepubliceerde commit aanvullen?"

msgid "Add all currently staged changes to this commit? Its commit ID will change. Nothing will be pushed automatically."
msgstr "Alle huidige staged wijzigingen aan deze commit toevoegen? De commit-ID verandert. Er wordt niets automatisch gepusht."

msgid "Amend Commit"
msgstr "Commit aanvullen"

msgid "Staged changes amended into commit"
msgstr "Staged wijzigingen aan commit toegevoegd"

msgid "Could Not Amend Commit"
msgstr "Commit kon niet worden aangevuld"

msgid "Undo Unpublished Commit?"
msgstr "Niet-gepubliceerde commit ongedaan maken?"

msgid "Remove this commit from the branch and return its contents to the staging area? No files will be deleted. Existing staged changes remain staged."
msgstr "Deze commit uit de branch verwijderen en de inhoud terugzetten in staging? Er worden geen bestanden verwijderd. Bestaande staged wijzigingen blijven staged."

msgid "Commit undone — changes returned to staging"
msgstr "Commit ongedaan gemaakt — wijzigingen teruggezet in staging"

msgid "Could Not Undo Commit"
msgstr "Commit kon niet ongedaan worden gemaakt"

msgid "History Operation Already in Progress"
msgstr "Geschiedenisbewerking al bezig"

msgid "Finish or abort the current Revert/Cherry-pick operation in Changes before starting another one."
msgstr "Voltooi of breek de huidige Revert/Cherry-pick in Wijzigingen af voordat je een nieuwe start."

msgid "Could Not Check History State"
msgstr "Geschiedenisstatus kon niet worden gecontroleerd"

msgid "Merge in Progress"
msgstr "Merge bezig"

msgid "Complete or abort the current merge before applying a history action."
msgstr "Voltooi of breek de huidige merge af voordat je een geschiedenisactie uitvoert."

msgid "Could Not Check Merge State"
msgstr "Merge-status kon niet worden gecontroleerd"

msgid "Could Not Read Repository Status"
msgstr "Repositorystatus kon niet worden gelezen"

msgid "Cannot Apply History Action Here"
msgstr "Geschiedenisactie kan hier niet worden uitgevoerd"

msgid "Switch to a normal local branch with at least one commit before reverting or cherry-picking."
msgstr "Wissel naar een normale lokale branch met minstens één commit voordat je een revert of cherry-pick uitvoert."

msgid "Commit or Stash Changes First"
msgstr "Commit of stash wijzigingen eerst"

msgid "Git Desk starts Revert and Cherry-pick from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk start Revert en Cherry-pick vanuit een schone working tree. Commit je werk of sla het op in Stashes en probeer opnieuw."

msgid "Commit Is Not on the Current Branch"
msgstr "Commit staat niet op de huidige branch"

msgid "Git Desk only reverts commits that are part of the current branch history. Use Cherry-pick when you want to apply a commit from another branch."
msgstr "Git Desk draait alleen commits terug die deel uitmaken van de geschiedenis van de huidige branch. Gebruik Cherry-pick om een commit uit een andere branch toe te passen."

msgid "Could Not Verify Commit Ancestry"
msgstr "Commitafkomst kon niet worden geverifieerd"

msgid "Commit Is Already HEAD"
msgstr "Commit is al HEAD"

msgid "The selected commit is already the current commit, so there is nothing to cherry-pick."
msgstr "De geselecteerde commit is al de huidige commit, dus er is niets om te cherry-picken."

msgid "Could Not Verify Current Commit"
msgstr "Huidige commit kon niet worden geverifieerd"

msgid "Revert Commit"
msgstr "Commit terugdraaien"

msgid "Cherry-pick Commit"
msgstr "Commit cherry-picken"

msgid "Repository Changed"
msgstr "Repository gewijzigd"

msgid "The current branch or working tree changed while the confirmation was open. Review the repository and try again."
msgstr "De huidige branch of working tree is gewijzigd terwijl de bevestiging openstond. Controleer de repository en probeer opnieuw."

msgid "Commit reverted"
msgstr "Commit teruggedraaid"

msgid "Commit cherry-picked"
msgstr "Commit ge-cherry-pickt"

msgid "Revert"
msgstr "Revert"

msgid "Abort Revert"
msgstr "Revert afbreken"

msgid "Cherry-pick"
msgstr "Cherry-pick"

msgid "Abort Cherry-pick"
msgstr "Cherry-pick afbreken"

msgid "History Action Failed"
msgstr "Geschiedenisactie mislukt"

msgid "Revert Failed"
msgstr "Revert mislukt"

msgid "Cherry-pick Failed"
msgstr "Cherry-pick mislukt"

msgid "History Operation Changed"
msgstr "Geschiedenisbewerking gewijzigd"

msgid "A different history operation is now active. Refresh and review Changes before continuing."
msgstr "Er is nu een andere geschiedenisbewerking actief. Vernieuw en controleer Wijzigingen voordat je doorgaat."

msgid "No History Operation in Progress"
msgstr "Geen geschiedenisbewerking bezig"

msgid "There is no Revert or Cherry-pick operation to continue."
msgstr "Er is geen Revert- of Cherry-pick-bewerking om voort te zetten."

msgid "Could Not Check Conflicts"
msgstr "Conflicten konden niet worden gecontroleerd"

msgid "Conflicts Still Need Resolution"
msgstr "Conflicten moeten nog worden opgelost"

msgid "Stage Remaining Changes"
msgstr "Stage resterende wijzigingen"

msgid "Tracked unstaged changes would not be included when the history operation continues. Stage the resolved changes first."
msgstr "Gevolgde unstaged wijzigingen worden niet meegenomen wanneer de geschiedenisbewerking doorgaat. Stage eerst de opgeloste wijzigingen."

msgid "Revert completed"
msgstr "Revert voltooid"

msgid "Cherry-pick completed"
msgstr "Cherry-pick voltooid"

msgid "Could Not Continue Revert"
msgstr "Revert kon niet worden voortgezet"

msgid "Could Not Continue Cherry-pick"
msgstr "Cherry-pick kon niet worden voortgezet"

msgid "A different history operation is now active. Refresh and review Changes before skipping."
msgstr "Er is nu een andere geschiedenisbewerking actief. Vernieuw en controleer Wijzigingen voordat je overslaat."

msgid "No Cherry-pick in Progress"
msgstr "Geen Cherry-pick bezig"

msgid "There is no Cherry-pick operation to skip."
msgstr "Er is geen Cherry-pick-bewerking om over te slaan."

msgid "Cherry-pick Still Has Conflicts"
msgstr "Cherry-pick heeft nog conflicten"

msgid "Skip is only offered for an empty Cherry-pick. Resolve the conflicts or abort the operation."
msgstr "Overslaan is alleen beschikbaar voor een lege Cherry-pick. Los de conflicten op of breek de bewerking af."

msgid "Cherry-pick Is No Longer Empty"
msgstr "Cherry-pick is niet meer leeg"

msgid "Tracked changes are present. Review and stage the resolution to continue, or abort the Cherry-pick."
msgstr "Er zijn gevolgde wijzigingen aanwezig. Controleer en stage de oplossing om door te gaan, of breek de Cherry-pick af."

msgid "Empty Cherry-pick skipped"
msgstr "Lege Cherry-pick overgeslagen"

msgid "Could Not Skip Cherry-pick"
msgstr "Cherry-pick kon niet worden overgeslagen"

msgid "Abort Current Revert?"
msgstr "Huidige revert afbreken?"

msgid "Abort Current Cherry-pick?"
msgstr "Huidige cherry-pick afbreken?"

msgid "A different history operation is now active. Refresh and review Changes before aborting."
msgstr "Er is nu een andere geschiedenisbewerking actief. Vernieuw en controleer Wijzigingen voordat je afbreekt."

msgid "There is no Revert or Cherry-pick operation to abort."
msgstr "Er is geen Revert- of Cherry-pick-bewerking om af te breken."

msgid "Abort Revert Failed"
msgstr "Revert afbreken mislukt"

msgid "Abort Cherry-pick Failed"
msgstr "Cherry-pick afbreken mislukt"

msgid "Could not load local commits not published to a configured remote."
msgstr "Lokale commits die niet naar een geconfigureerde remote zijn gepubliceerd konden niet worden geladen."

msgid "Outgoing commits unavailable"
msgstr "Uitgaande commits niet beschikbaar"

msgid "No commits yet"
msgstr "Nog geen commits"

msgid "Your first commit will appear here."
msgstr "Je eerste commit verschijnt hier."

msgid "No changed files."
msgstr "Geen gewijzigde bestanden."

msgid "Current branch · merge in progress"
msgstr "Huidige branch · merge bezig"

msgid "Current branch · history operation in progress"
msgstr "Huidige branch · geschiedenisbewerking bezig"

msgid "Current branch · first commit not created yet"
msgstr "Huidige branch · eerste commit nog niet gemaakt"

msgid "Current branch"
msgstr "Huidige branch"

msgid "Remote branch"
msgstr "Remote branch"

msgid "Local branch"
msgstr "Lokale branch"

msgid "Switch to Branch"
msgstr "Naar branch wisselen"

msgid "Merge into Current Branch…"
msgstr "Mergen in huidige branch…"

msgid "Abort Merge…"
msgstr "Merge afbreken…"

msgid "Unset Upstream"
msgstr "Upstream verwijderen"

msgid "Rename Branch…"
msgstr "Branch hernoemen…"

msgid "Delete Branch…"
msgstr "Branch verwijderen…"

msgid "Branch actions"
msgstr "Branchacties"

msgid "Remote branch actions"
msgstr "Remote-branchacties"

msgid "No local branches yet"
msgstr "Nog geen lokale branches"

msgid "No remote branches configured"
msgstr "Geen remote branches geconfigureerd"

msgid "feature/my-branch"
msgstr "feature/my-branch"

msgid "New Branch"
msgstr "Nieuwe branch"

msgid "Create a branch from the current branch and switch to it. Uncommitted changes stay in the working tree."
msgstr "Maak een branch vanaf de huidige branch en wissel ernaar. Niet-gecommitte wijzigingen blijven in de working tree."

msgid "Create & Switch"
msgstr "Maken en wisselen"

msgid "origin/main"
msgstr "origin/main"

msgid "Enter the remote branch this local branch should track, for example origin/main."
msgstr "Voer de remote branch in die deze lokale branch moet volgen, bijvoorbeeld origin/main."

msgid "Set Upstream"
msgstr "Upstream instellen"

msgid "This repository has uncommitted changes. Git Desk will leave them in the working tree. Git may refuse the switch if the target branch would overwrite them."
msgstr "Deze repository heeft niet-gecommitte wijzigingen. Git Desk laat ze in de working tree staan. Git kan de wissel weigeren als de doelbranch ze zou overschrijven."

msgid "Switch Branch"
msgstr "Branch wisselen"

msgid "Continue Revert"
msgstr "Revert voortzetten"

msgid "Abort Revert…"
msgstr "Revert afbreken…"

msgid "Continue Cherry-pick"
msgstr "Cherry-pick voortzetten"

msgid "Abort Cherry-pick…"
msgstr "Cherry-pick afbreken…"

msgid "Finish an empty Cherry-pick without creating a commit."
msgstr "Rond een lege Cherry-pick af zonder een commit te maken."

msgid "Continue the current Git history operation using the staged resolution."
msgstr "Zet de huidige Git-geschiedenisbewerking voort met de gestagede oplossing."

msgid "Git Desk must verify the conflict state before continuing."
msgstr "Git Desk moet de conflictstatus controleren voordat je doorgaat."

msgid "Git Desk must verify the working tree state before continuing."
msgstr "Git Desk moet de status van de working tree controleren voordat je doorgaat."

msgid "Resolve and mark every conflicted file before continuing."
msgstr "Los elk conflicterend bestand op en markeer het als opgelost voordat je doorgaat."

msgid "There are no tracked changes to commit. Skip the empty Cherry-pick."
msgstr "Er zijn geen gevolgde wijzigingen om te committen. Sla de lege Cherry-pick over."

msgid "Stage the remaining tracked changes before continuing."
msgstr "Stage de resterende gevolgde wijzigingen voordat je doorgaat."

msgid "Git Desk could not verify the conflict state. Refresh the repository or abort the merge."
msgstr "Git Desk kon de conflictstatus niet controleren. Vernieuw de repository of breek de merge af."

msgid "Conflicts are resolved, but tracked unstaged changes remain. Stage them before completing the merge."
msgstr "De conflicten zijn opgelost, maar er zijn nog gevolgde unstaged wijzigingen. Stage ze voordat je de merge voltooit."

msgid "All conflicts are resolved and staged. Complete the merge to create the merge commit."
msgstr "Alle conflicten zijn opgelost en gestaged. Voltooi de merge om de merge-commit te maken."

msgid "Create the merge commit using Git’s prepared merge message."
msgstr "Maak de merge-commit met het door Git voorbereide mergebericht."

msgid "Git Desk must verify the conflict state before completing the merge."
msgstr "Git Desk moet de conflictstatus controleren voordat de merge wordt voltooid."

msgid "Resolve and mark every conflicted file before completing the merge."
msgstr "Los elk conflicterend bestand op en markeer het als opgelost voordat je de merge voltooit."

msgid "Stage the remaining tracked changes before completing the merge."
msgstr "Stage de resterende gevolgde wijzigingen voordat je de merge voltooit."

msgid "No Merge in Progress"
msgstr "Geen merge bezig"

msgid "There is no active merge to complete."
msgstr "Er is geen actieve merge om te voltooien."

msgid "Tracked unstaged changes would not be included in the merge commit. Stage them first, then complete the merge."
msgstr "Gevolgde unstaged wijzigingen worden niet opgenomen in de merge-commit. Stage ze eerst en voltooi daarna de merge."

msgid "Merge completed"
msgstr "Merge voltooid"

msgid "Complete Merge Failed"
msgstr "Merge voltooien mislukt"

msgid "Merge Already in Progress"
msgstr "Merge al bezig"

msgid "Finish the current merge or abort it before starting another one."
msgstr "Voltooi de huidige merge of breek hem af voordat je een nieuwe start."

msgid "Cannot Merge Here"
msgstr "Kan hier niet mergen"

msgid "Check out a normal local branch with at least one commit before merging another branch into it."
msgstr "Check een normale lokale branch met minstens één commit uit voordat je er een andere branch in merget."

msgid "Git Desk only starts a branch merge from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk start een branch-merge alleen vanuit een schone working tree. Commit je werk of sla het op in Stashes en probeer het opnieuw."

msgid "Git will fast-forward when possible. Otherwise it will create a merge commit. If conflicts occur, Git Desk will keep the merge open so you can resolve the files in Changes or abort the merge from Branches."
msgstr "Git voert waar mogelijk een fast-forward uit. Anders wordt een merge-commit gemaakt. Bij conflicten houdt Git Desk de merge open zodat je bestanden in Wijzigingen kunt oplossen of de merge vanuit Branches kunt afbreken."

msgid "Merge Branch"
msgstr "Branch mergen"

msgid "The current branch or working tree changed while the merge confirmation was open. Review the repository and try again."
msgstr "De huidige branch of working tree is gewijzigd terwijl de mergebevestiging openstond. Controleer de repository en probeer het opnieuw."

msgid "Merge Failed"
msgstr "Merge mislukt"

msgid "Abort Current Merge?"
msgstr "Huidige merge afbreken?"

msgid "Discard the changes created by the current merge attempt and restore the branch to its pre-merge state?"
msgstr "De wijzigingen van de huidige mergepoging verwerpen en de branch herstellen naar de toestand vóór de merge?"

msgid "Abort Merge"
msgstr "Merge afbreken"

msgid "There is no active merge to abort."
msgstr "Er is geen actieve merge om af te breken."

msgid "Merge aborted"
msgstr "Merge afgebroken"

msgid "Abort Merge Failed"
msgstr "Merge afbreken mislukt"

msgid "Rename Branch"
msgstr "Branch hernoemen"

msgid "Renaming a branch changes its local name without changing its commits."
msgstr "Een branch hernoemen verandert alleen de lokale naam en wijzigt de commits niet."

msgid "Rename"
msgstr "Hernoemen"

msgid "This removes the local branch reference. Git Desk uses Git’s safe deletion, so Git will refuse if it considers the branch not fully merged."
msgstr "Dit verwijdert de lokale branchreferentie. Git Desk gebruikt de veilige verwijdering van Git, dus Git weigert als de branch volgens Git nog niet volledig is gemerged."

msgid "Delete Branch"
msgstr "Branch verwijderen"

msgid "Type"
msgstr "Type"

msgid "Status"
msgstr "Status"

msgid "Not checked out"
msgstr "Niet uitgecheckt"

msgid "Not configured"
msgstr "Niet geconfigureerd"

msgid "Upstream"
msgstr "Upstream"

msgid "origin"
msgstr "origin"

msgid "https://github.com/user/repository.git"
msgstr "https://github.com/user/repository.git"

msgid "Add Remote"
msgstr "Remote toevoegen"

msgid "Connect this repository to another Git repository. Enter a remote name and URL."
msgstr "Koppel deze repository aan een andere Git-repository. Voer een remotenaam en URL in."

msgid "Remove Remote…"
msgstr "Remote verwijderen…"

msgid "Remote actions"
msgstr "Remote-acties"

msgid "No remotes configured"
msgstr "Geen remotes geconfigureerd"

msgid "Add a remote to connect this repository to GitHub, GitLab, Codeberg, or another Git server."
msgstr "Voeg een remote toe om deze repository te verbinden met GitHub, GitLab, Codeberg of een andere Git-server."

msgid "Remove Remote"
msgstr "Remote verwijderen"

msgid "No saved stashes"
msgstr "Geen opgeslagen stashes"

msgid "Loading stash…"
msgstr "Stash laden…"

msgid "This stash has no visible diff."
msgstr "Deze stash heeft geen zichtbare diff."

msgid "Temporarily save staged and working-tree changes."
msgstr "Sla staged en working-tree-wijzigingen tijdelijk op."

msgid "Create the first commit before using Stash."
msgstr "Maak de eerste commit voordat je Stash gebruikt."

msgid "Optional stash message"
msgstr "Optioneel stashbericht"

msgid "Include untracked files"
msgstr "Niet-gevolgde bestanden meenemen"

msgid "Stash Changes"
msgstr "Wijzigingen stashen"

msgid "Temporarily save your current staged and working-tree changes, then return to a clean working tree."
msgstr "Sla je huidige staged en working-tree-wijzigingen tijdelijk op en keer daarna terug naar een schone working tree."

msgid "Stash Requires a First Commit"
msgstr "Stash vereist een eerste commit"

msgid "Create the repository's first commit before using Stash."
msgstr "Maak de eerste commit van de repository voordat je Stash gebruikt."

msgid "Stash created"
msgstr "Stash aangemaakt"

msgid "No local changes to stash"
msgstr "Geen lokale wijzigingen om te stashen"

msgid "Stash Failed"
msgstr "Stash mislukt"

msgid "Apply Stash Failed"
msgstr "Stash toepassen mislukt"

msgid "Pop Stash?"
msgstr "Stash poppen?"

msgid "Pop Stash"
msgstr "Stash poppen"

msgid "Pop Stash Failed"
msgstr "Stash poppen mislukt"

msgid "Delete Stash?"
msgstr "Stash verwijderen?"

msgid "Delete Stash Failed"
msgstr "Stash verwijderen mislukt"

msgid "No tags"
msgstr "Geen tags"

msgid "Annotated"
msgstr "Geannoteerd"

msgid "Lightweight"
msgstr "Lightweight"

msgid "Annotated tag"
msgstr "Geannoteerde tag"

