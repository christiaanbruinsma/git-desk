msgid ""
msgstr ""
"Project-Id-Version: git-desk 0.9.0\n"
"PO-Revision-Date: 2026-08-16 00:36+0200\n"
"Last-Translator: Christiaan Bruinsma\n"
"Language-Team: Deutsch\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Easy to start. Powerful enough to stay."
msgstr "Easy to start. Powerful enough to stay."

msgid "Git Desk"
msgstr "Git Desk"

msgid "https://github.com/owner/repository.git"
msgstr "https://github.com/owner/repository.git"

msgid "Clone Repository"
msgstr "Repository klonen"

msgid "Enter a Git repository URL. Git Desk will then ask where to create the cloned repository."
msgstr "Gib eine Git-Repository-URL ein. Git Desk fragt anschließend, wo das geklonte Repository erstellt werden soll."

msgid "Cancel"
msgstr "Abbrechen"

msgid "Continue"
msgstr "Weiter"

msgid "Choose Location for Cloned Repository"
msgstr "Speicherort für geklonte Repository wählen"

msgid "Choose Project Folder"
msgstr "Projektordner wählen"

msgid "Open Project"
msgstr "Projekt öffnen"

msgid "project"
msgstr "Projekt"

msgid "Project folder not found"
msgstr "Projektordner nicht gefunden"

msgid "Remove from Recent Projects"
msgstr "Aus „Letzte Projekte“ entfernen"

msgid "Locate Project…"
msgstr "Projekt suchen…"

msgid "Locate Project"
msgstr "Projekt suchen"

msgid "Close"
msgstr "Schließen"

msgid "Git Desk can’t find {name} at its saved location. The folder may have been moved or deleted."
msgstr "Git Desk kann {name} am gespeicherten Ort nicht finden. Der Ordner wurde möglicherweise verschoben oder gelöscht."

msgid "No textual diff available."
msgstr "Kein Text-Diff verfügbar."

msgid "Repository"
msgstr "Repository"

msgid "Back to projects"
msgstr "Zurück zu Projekten"

msgid "Local project folder"
msgstr "Lokaler Projektordner"

msgid "Open Repository Folder"
msgstr "Repository-Ordner öffnen"

msgid "Refresh repository"
msgstr "Repository aktualisieren"

msgid "Push"
msgstr "Push"

msgid "Pull"
msgstr "Pull"

msgid "Fetch"
msgstr "Fetch"

msgid "Inspector"
msgstr "Inspektor"

msgid "Select an item to inspect it."
msgstr "Element auswählen, um es zu prüfen."

msgid "Edit Message…"
msgstr "Nachricht bearbeiten…"

msgid "Change the message of this unpublished commit without including staged changes."
msgstr "Ändere die Nachricht dieses unveröffentlichten Commits, ohne vorgemerkte Änderungen einzubeziehen."

msgid "Amend"
msgstr "Amend"

msgid "Add all currently staged changes to this unpublished commit."
msgstr "Füge alle derzeit vorgemerkten Änderungen diesem unveröffentlichten Commit hinzu."

msgid "Undo Commit"
msgstr "Commit rückgängig machen"

msgid "Remove this unpublished commit from the branch and return its contents to staging."
msgstr "Entferne diesen unveröffentlichten Commit aus dem Branch und lege seinen Inhalt wieder in den Staging-Bereich."

msgid "Revert Commit…"
msgstr "Commit zurücksetzen…"

msgid "Create a new commit that reverses this commit on the current branch."
msgstr "Erstelle einen neuen Commit, der diesen Commit auf dem aktuellen Branch rückgängig macht."

msgid "Cherry-pick…"
msgstr "Cherry-pick…"

msgid "Apply this commit on top of the current branch as a new commit."
msgstr "Wende diesen Commit als neuen Commit auf dem aktuellen Branch an."

msgid "Nothing selected"
msgstr "Nichts ausgewählt"

msgid "Select a change, commit, branch, stash, or tag to inspect its details."
msgstr "Änderung, Commit, Branch, Stash oder Tag auswählen, um Details zu prüfen."

msgid "Apply"
msgstr "Anwenden"

msgid "Apply this stash to the working tree and keep it in the stash list."
msgstr "Wende diesen Stash auf den Arbeitsbaum an und behalte ihn in der Stash-Liste."

msgid "Pop"
msgstr "Pop"

msgid "Apply this stash and remove it from the stash list when successful."
msgstr "Wende diesen Stash an und entferne ihn bei Erfolg aus der Stash-Liste."

msgid "Delete Stash"
msgstr "Stash löschen"

msgid "Permanently remove this saved stash without applying it."
msgstr "Entferne diesen gespeicherten Stash dauerhaft, ohne ihn anzuwenden."

msgid "Push Tag…"
msgstr "Tag pushen…"

msgid "Push exactly this tag to one configured remote without force-updating an existing remote tag."
msgstr "Pushe genau diesen Tag zu einem konfigurierten Remote, ohne einen vorhandenen Remote-Tag erzwungen zu aktualisieren."

msgid "Delete Tag…"
msgstr "Tag löschen…"

msgid "Delete this local tag. Tags already present on remotes are not deleted."
msgstr "Lösche diesen lokalen Tag. Bereits auf Remotes vorhandene Tags werden nicht gelöscht."

msgid "Expand Inspector"
msgstr "Inspektor erweitern"

msgid "Restore Inspector Width"
msgstr "Inspektorbreite wiederherstellen"

msgid "Could Not Open Repository Folder"
msgstr "Repository-Ordner konnte nicht geöffnet werden"

msgid "Could Not Open Files"
msgstr "Dateien konnten nicht geöffnet werden"

msgid "Working tree clean"
msgstr "Working Tree sauber"

msgid "Resolve conflicted files individually before staging all changes."
msgstr "Löse Dateien mit Konflikten einzeln, bevor du alle Änderungen vormerkst."

msgid "Stage all working-tree changes"
msgstr "Alle Änderungen stagen"

msgid "Conflict · resolve the file, then mark resolved"
msgstr "Konflikt · Datei lösen und anschließend als gelöst markieren"

msgid "Unstage"
msgstr "Unstage"

msgid "Mark Resolved"
msgstr "Als gelöst markieren"

msgid "Stage"
msgstr "Stage"

msgid "Stage this resolved file so Git can continue the current operation."
msgstr "Merke diese gelöste Datei vor, damit Git den aktuellen Vorgang fortsetzen kann."

msgid "Delete Untracked File…"
msgstr "Ungetrackte Datei löschen…"

msgid "Discard Changes…"
msgstr "Änderungen verwerfen…"

msgid "Show Parent Folder in Files"
msgstr "Übergeordneten Ordner in Dateien anzeigen"

msgid "Show in Files"
msgstr "In Dateien anzeigen"

msgid "Actions"
msgstr "Aktionen"

msgid "Change actions"
msgstr "Änderungsaktionen"

msgid "This file is not tracked by Git. Deleting it cannot be undone by Git Desk."
msgstr "Diese Datei wird nicht von Git verfolgt. Das Löschen kann von Git Desk nicht rückgängig gemacht werden."

msgid "The working-tree version will be restored from Git’s index. Any staged version is kept. This cannot be undone by Git Desk."
msgstr "Die Version im Arbeitsbaum wird aus dem Git-Index wiederhergestellt. Eine vorgemerkte Version bleibt erhalten. Git Desk kann dies nicht rückgängig machen."

msgid "Delete File"
msgstr "Datei löschen"

msgid "Discard Changes"
msgstr "Änderungen verwerfen"

msgid "Ready to commit"
msgstr "Bereit zum Committen"

msgid "Working tree"
msgstr "Arbeitsbaum"

msgid "Merge commits require choosing an explicit mainline parent. Git Desk does not guess that parent."
msgstr "Merge-Commits erfordern die ausdrückliche Auswahl eines Mainline-Parents. Git Desk errät diesen Parent nicht."

msgid "Switch to a normal branch with a clean working tree before applying a history action."
msgstr "Wechsle zu einem normalen Branch mit sauberem Arbeitsbaum, bevor du eine Verlaufsaktion ausführst."

msgid "Finish or abort the current history operation first."
msgstr "Schließe den aktuellen Verlaufsvorgang zuerst ab oder brich ihn ab."

msgid "Create a new commit on the current branch without rewriting existing history."
msgstr "Erstelle einen neuen Commit auf dem aktuellen Branch, ohne den vorhandenen Verlauf umzuschreiben."

msgid "Switch to a normal branch with a clean working tree before cherry-picking a commit."
msgstr "Wechsle zu einem normalen Branch mit sauberem Arbeitsbaum, bevor du einen Commit per Cherry-pick übernimmst."

msgid "Stage changes first to amend this unpublished commit."
msgstr "Merke zuerst Änderungen vor, um diesen unveröffentlichten Commit zu ergänzen."

msgid "Could Not Load Commit Message"
msgstr "Commit-Nachricht konnte nicht geladen werden"

msgid "Edit Commit Message"
msgstr "Commit-Nachricht bearbeiten"

msgid "Change the message of this unpublished commit. Currently staged changes will not be included."
msgstr "Ändere die Nachricht dieses unveröffentlichten Commits. Derzeit vorgemerkte Änderungen werden nicht einbezogen."

msgid "Save Message"
msgstr "Nachricht speichern"

msgid "Commit message updated"
msgstr "Commit-Nachricht aktualisiert"

msgid "Could Not Edit Commit"
msgstr "Commit konnte nicht bearbeitet werden"

msgid "Amend Unpublished Commit?"
msgstr "Unveröffentlichten Commit ergänzen?"

msgid "Add all currently staged changes to this commit? Its commit ID will change. Nothing will be pushed automatically."
msgstr "Alle derzeit vorgemerkten Änderungen zu diesem Commit hinzufügen? Seine Commit-ID ändert sich. Nichts wird automatisch gepusht."

msgid "Amend Commit"
msgstr "Commit ergänzen"

msgid "Staged changes amended into commit"
msgstr "Vorgemerkte Änderungen in Commit übernommen"

msgid "Could Not Amend Commit"
msgstr "Commit konnte nicht ergänzt werden"

msgid "Undo Unpublished Commit?"
msgstr "Unveröffentlichten Commit rückgängig machen?"

msgid "Remove this commit from the branch and return its contents to the staging area? No files will be deleted. Existing staged changes remain staged."
msgstr "Diesen Commit aus dem Branch entfernen und seinen Inhalt in den Staging-Bereich zurücklegen? Es werden keine Dateien gelöscht. Bereits vorgemerkte Änderungen bleiben vorgemerkt."

msgid "Commit undone — changes returned to staging"
msgstr "Commit rückgängig gemacht — Änderungen wieder im Staging-Bereich"

msgid "Could Not Undo Commit"
msgstr "Commit konnte nicht rückgängig gemacht werden"

msgid "History Operation Already in Progress"
msgstr "Verlaufsvorgang läuft bereits"

msgid "Finish or abort the current Revert/Cherry-pick operation in Changes before starting another one."
msgstr "Schließe den aktuellen Revert-/Cherry-pick-Vorgang unter Änderungen ab oder brich ihn ab, bevor du einen neuen startest."

msgid "Could Not Check History State"
msgstr "Verlaufsstatus konnte nicht geprüft werden"

msgid "Merge in Progress"
msgstr "Merge läuft"

msgid "Complete or abort the current merge before applying a history action."
msgstr "Schließe den aktuellen Merge ab oder brich ihn ab, bevor du eine Verlaufsaktion ausführst."

msgid "Could Not Check Merge State"
msgstr "Merge-Status konnte nicht geprüft werden"

msgid "Could Not Read Repository Status"
msgstr "Repository-Status konnte nicht gelesen werden"

msgid "Cannot Apply History Action Here"
msgstr "Verlaufsaktion kann hier nicht angewendet werden"

msgid "Switch to a normal local branch with at least one commit before reverting or cherry-picking."
msgstr "Wechsle zu einem normalen lokalen Branch mit mindestens einem Commit, bevor du einen Revert oder Cherry-pick ausführst."

msgid "Commit or Stash Changes First"
msgstr "Änderungen zuerst committen oder stashen"

msgid "Git Desk starts Revert and Cherry-pick from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk startet Revert und Cherry-pick nur mit sauberem Arbeitsbaum. Committe deine Arbeit oder speichere sie in Stashes und versuche es erneut."

msgid "Commit Is Not on the Current Branch"
msgstr "Commit befindet sich nicht auf dem aktuellen Branch"

msgid "Git Desk only reverts commits that are part of the current branch history. Use Cherry-pick when you want to apply a commit from another branch."
msgstr "Git Desk setzt nur Commits zurück, die zum Verlauf des aktuellen Branches gehören. Verwende Cherry-pick, um einen Commit aus einem anderen Branch anzuwenden."

msgid "Could Not Verify Commit Ancestry"
msgstr "Commit-Abstammung konnte nicht geprüft werden"

msgid "Commit Is Already HEAD"
msgstr "Commit ist bereits HEAD"

msgid "The selected commit is already the current commit, so there is nothing to cherry-pick."
msgstr "Der ausgewählte Commit ist bereits der aktuelle Commit; es gibt daher nichts per Cherry-pick zu übernehmen."

msgid "Could Not Verify Current Commit"
msgstr "Aktueller Commit konnte nicht geprüft werden"

msgid "Revert Commit"
msgstr "Commit zurücksetzen"

msgid "Cherry-pick Commit"
msgstr "Commit per Cherry-pick übernehmen"

msgid "Repository Changed"
msgstr "Repository geändert"

msgid "The current branch or working tree changed while the confirmation was open. Review the repository and try again."
msgstr "Der aktuelle Branch oder Arbeitsbaum wurde geändert, während die Bestätigung geöffnet war. Prüfe das Repository und versuche es erneut."

msgid "Commit reverted"
msgstr "Commit zurückgesetzt"

msgid "Commit cherry-picked"
msgstr "Commit per Cherry-pick übernommen"

msgid "Revert"
msgstr "Revert"

msgid "Abort Revert"
msgstr "Revert abbrechen"

msgid "Cherry-pick"
msgstr "Cherry-pick"

msgid "Abort Cherry-pick"
msgstr "Cherry-pick abbrechen"

msgid "History Action Failed"
msgstr "Verlaufsaktion fehlgeschlagen"

msgid "Revert Failed"
msgstr "Revert fehlgeschlagen"

msgid "Cherry-pick Failed"
msgstr "Cherry-pick fehlgeschlagen"

msgid "History Operation Changed"
msgstr "Verlaufsvorgang geändert"

msgid "A different history operation is now active. Refresh and review Changes before continuing."
msgstr "Jetzt ist ein anderer Verlaufsvorgang aktiv. Aktualisiere und prüfe Änderungen, bevor du fortfährst."

msgid "No History Operation in Progress"
msgstr "Kein Verlaufsvorgang aktiv"

msgid "There is no Revert or Cherry-pick operation to continue."
msgstr "Es gibt keinen Revert- oder Cherry-pick-Vorgang zum Fortsetzen."

msgid "Could Not Check Conflicts"
msgstr "Konflikte konnten nicht geprüft werden"

msgid "Conflicts Still Need Resolution"
msgstr "Konflikte müssen noch gelöst werden"

msgid "Stage Remaining Changes"
msgstr "Verbleibende Änderungen vormerken"

msgid "Tracked unstaged changes would not be included when the history operation continues. Stage the resolved changes first."
msgstr "Verfolgte, nicht vorgemerkte Änderungen würden beim Fortsetzen des Verlaufsvorgangs nicht einbezogen. Merke die gelösten Änderungen zuerst vor."

msgid "Revert completed"
msgstr "Revert abgeschlossen"

msgid "Cherry-pick completed"
msgstr "Cherry-pick abgeschlossen"

msgid "Could Not Continue Revert"
msgstr "Revert konnte nicht fortgesetzt werden"

msgid "Could Not Continue Cherry-pick"
msgstr "Cherry-pick konnte nicht fortgesetzt werden"

msgid "A different history operation is now active. Refresh and review Changes before skipping."
msgstr "Jetzt ist ein anderer Verlaufsvorgang aktiv. Aktualisiere und prüfe Änderungen, bevor du überspringst."

msgid "No Cherry-pick in Progress"
msgstr "Kein Cherry-pick aktiv"

msgid "There is no Cherry-pick operation to skip."
msgstr "Es gibt keinen Cherry-pick-Vorgang zum Überspringen."

msgid "Cherry-pick Still Has Conflicts"
msgstr "Cherry-pick enthält noch Konflikte"

msgid "Skip is only offered for an empty Cherry-pick. Resolve the conflicts or abort the operation."
msgstr "Überspringen ist nur bei einem leeren Cherry-pick möglich. Löse die Konflikte oder brich den Vorgang ab."

msgid "Cherry-pick Is No Longer Empty"
msgstr "Cherry-pick ist nicht mehr leer"

msgid "Tracked changes are present. Review and stage the resolution to continue, or abort the Cherry-pick."
msgstr "Es sind verfolgte Änderungen vorhanden. Prüfe und merke die Lösung vor, um fortzufahren, oder brich den Cherry-pick ab."

msgid "Empty Cherry-pick skipped"
msgstr "Leerer Cherry-pick übersprungen"

msgid "Could Not Skip Cherry-pick"
msgstr "Cherry-pick konnte nicht übersprungen werden"

msgid "Abort Current Revert?"
msgstr "Aktuellen Revert abbrechen?"

msgid "Abort Current Cherry-pick?"
msgstr "Aktuellen Cherry-pick abbrechen?"

msgid "A different history operation is now active. Refresh and review Changes before aborting."
msgstr "Jetzt ist ein anderer Verlaufsvorgang aktiv. Aktualisiere und prüfe Änderungen, bevor du abbrichst."

msgid "There is no Revert or Cherry-pick operation to abort."
msgstr "Es gibt keinen Revert- oder Cherry-pick-Vorgang zum Abbrechen."

msgid "Abort Revert Failed"
msgstr "Revert konnte nicht abgebrochen werden"

msgid "Abort Cherry-pick Failed"
msgstr "Cherry-pick konnte nicht abgebrochen werden"

msgid "Could not load local commits not published to a configured remote."
msgstr "Lokale Commits, die nicht zu einem konfigurierten Remote veröffentlicht wurden, konnten nicht geladen werden."

msgid "Outgoing commits unavailable"
msgstr "Ausgehende Commits nicht verfügbar"

msgid "No commits yet"
msgstr "Noch keine Commits"

msgid "Your first commit will appear here."
msgstr "Der erste Commit erscheint hier."

msgid "No changed files."
msgstr "Keine geänderten Dateien."

msgid "Current branch · merge in progress"
msgstr "Aktueller Branch · Merge läuft"

msgid "Current branch · history operation in progress"
msgstr "Aktueller Branch · Verlaufsvorgang läuft"

msgid "Current branch · first commit not created yet"
msgstr "Aktueller Branch · erster Commit noch nicht erstellt"

msgid "Current branch"
msgstr "Aktueller Branch"

msgid "Remote branch"
msgstr "Remote-Branch"

msgid "Local branch"
msgstr "Lokaler Branch"

msgid "Switch to Branch"
msgstr "Zu Branch wechseln"

msgid "Merge into Current Branch…"
msgstr "In aktuellen Branch mergen…"

msgid "Abort Merge…"
msgstr "Merge abbrechen…"

msgid "Unset Upstream"
msgstr "Upstream entfernen"

msgid "Rename Branch…"
msgstr "Branch umbenennen…"

msgid "Delete Branch…"
msgstr "Branch löschen…"

msgid "Branch actions"
msgstr "Branch-Aktionen"

msgid "Remote branch actions"
msgstr "Remote-Branch-Aktionen"

msgid "No local branches yet"
msgstr "Noch keine lokalen Branches"

msgid "No remote branches configured"
msgstr "Keine Remote-Branches konfiguriert"

msgid "feature/my-branch"
msgstr "feature/my-branch"

msgid "New Branch"
msgstr "Neuer Branch"

msgid "Create a branch from the current branch and switch to it. Uncommitted changes stay in the working tree."
msgstr "Erstelle einen Branch vom aktuellen Branch und wechsle zu ihm. Nicht commitete Änderungen bleiben im Arbeitsbaum."

msgid "Create & Switch"
msgstr "Erstellen und wechseln"

msgid "origin/main"
msgstr "origin/main"

msgid "Enter the remote branch this local branch should track, for example origin/main."
msgstr "Gib den Remote-Branch ein, dem dieser lokale Branch folgen soll, zum Beispiel origin/main."

msgid "Set Upstream"
msgstr "Upstream festlegen"

msgid "This repository has uncommitted changes. Git Desk will leave them in the working tree. Git may refuse the switch if the target branch would overwrite them."
msgstr "Dieses Repository enthält nicht commitete Änderungen. Git Desk lässt sie im Arbeitsbaum. Git kann den Wechsel verweigern, wenn der Ziel-Branch sie überschreiben würde."

msgid "Switch Branch"
msgstr "Branch wechseln"

msgid "Continue Revert"
msgstr "Revert fortsetzen"

msgid "Abort Revert…"
msgstr "Revert abbrechen…"

msgid "Continue Cherry-pick"
msgstr "Cherry-pick fortsetzen"

msgid "Abort Cherry-pick…"
msgstr "Cherry-pick abbrechen…"

msgid "Finish an empty Cherry-pick without creating a commit."
msgstr "Einen leeren Cherry-pick abschließen, ohne einen Commit zu erstellen."

msgid "Continue the current Git history operation using the staged resolution."
msgstr "Den aktuellen Git-Verlaufsvorgang mit der vorgemerkten Lösung fortsetzen."

msgid "Git Desk must verify the conflict state before continuing."
msgstr "Git Desk muss den Konfliktstatus prüfen, bevor fortgefahren wird."

msgid "Git Desk must verify the working tree state before continuing."
msgstr "Git Desk muss den Status des Arbeitsbaums prüfen, bevor fortgefahren wird."

msgid "Resolve and mark every conflicted file before continuing."
msgstr "Alle Dateien mit Konflikten lösen und als gelöst markieren, bevor fortgefahren wird."

msgid "There are no tracked changes to commit. Skip the empty Cherry-pick."
msgstr "Es gibt keine verfolgten Änderungen zum Committen. Überspringe den leeren Cherry-pick."

msgid "Stage the remaining tracked changes before continuing."
msgstr "Die verbleibenden verfolgten Änderungen vormerken, bevor fortgefahren wird."

msgid "Git Desk could not verify the conflict state. Refresh the repository or abort the merge."
msgstr "Git Desk konnte den Konfliktstatus nicht prüfen. Aktualisiere das Repository oder brich den Merge ab."

msgid "Conflicts are resolved, but tracked unstaged changes remain. Stage them before completing the merge."
msgstr "Die Konflikte sind gelöst, aber es gibt noch verfolgte, nicht vorgemerkte Änderungen. Merke sie vor, bevor du den Merge abschließt."

msgid "All conflicts are resolved and staged. Complete the merge to create the merge commit."
msgstr "Alle Konflikte sind gelöst und vorgemerkt. Schließe den Merge ab, um den Merge-Commit zu erstellen."

msgid "Create the merge commit using Git’s prepared merge message."
msgstr "Den Merge-Commit mit der von Git vorbereiteten Merge-Nachricht erstellen."

msgid "Git Desk must verify the conflict state before completing the merge."
msgstr "Git Desk muss den Konfliktstatus prüfen, bevor der Merge abgeschlossen wird."

msgid "Resolve and mark every conflicted file before completing the merge."
msgstr "Alle Dateien mit Konflikten lösen und als gelöst markieren, bevor der Merge abgeschlossen wird."

msgid "Stage the remaining tracked changes before completing the merge."
msgstr "Die verbleibenden verfolgten Änderungen vormerken, bevor der Merge abgeschlossen wird."

msgid "No Merge in Progress"
msgstr "Kein Merge aktiv"

msgid "There is no active merge to complete."
msgstr "Es gibt keinen aktiven Merge zum Abschließen."

msgid "Tracked unstaged changes would not be included in the merge commit. Stage them first, then complete the merge."
msgstr "Verfolgte, nicht vorgemerkte Änderungen würden nicht in den Merge-Commit aufgenommen. Merke sie zuerst vor und schließe dann den Merge ab."

msgid "Merge completed"
msgstr "Merge abgeschlossen"

msgid "Complete Merge Failed"
msgstr "Merge konnte nicht abgeschlossen werden"

msgid "Merge Already in Progress"
msgstr "Merge bereits aktiv"

msgid "Finish the current merge or abort it before starting another one."
msgstr "Schließe den aktuellen Merge ab oder brich ihn ab, bevor du einen weiteren startest."

msgid "Cannot Merge Here"
msgstr "Hier kann nicht gemergt werden"

msgid "Check out a normal local branch with at least one commit before merging another branch into it."
msgstr "Checke einen normalen lokalen Branch mit mindestens einem Commit aus, bevor du einen anderen Branch hineinmergst."

msgid "Git Desk only starts a branch merge from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk startet einen Branch-Merge nur mit einem sauberen Arbeitsbaum. Committe deine Arbeit oder speichere sie in Stashes und versuche es erneut."

msgid "Git will fast-forward when possible. Otherwise it will create a merge commit. If conflicts occur, Git Desk will keep the merge open so you can resolve the files in Changes or abort the merge from Branches."
msgstr "Git führt nach Möglichkeit einen Fast-Forward durch. Andernfalls wird ein Merge-Commit erstellt. Bei Konflikten lässt Git Desk den Merge offen, damit du die Dateien unter Änderungen lösen oder den Merge unter Branches abbrechen kannst."

msgid "Merge Branch"
msgstr "Branch mergen"

msgid "The current branch or working tree changed while the merge confirmation was open. Review the repository and try again."
msgstr "Der aktuelle Branch oder Arbeitsbaum wurde geändert, während die Merge-Bestätigung geöffnet war. Prüfe das Repository und versuche es erneut."

msgid "Merge Failed"
msgstr "Merge fehlgeschlagen"

msgid "Abort Current Merge?"
msgstr "Aktuellen Merge abbrechen?"

msgid "Discard the changes created by the current merge attempt and restore the branch to its pre-merge state?"
msgstr "Die durch den aktuellen Merge-Versuch erzeugten Änderungen verwerfen und den Branch auf den Zustand vor dem Merge zurücksetzen?"

msgid "Abort Merge"
msgstr "Merge abbrechen"

msgid "There is no active merge to abort."
msgstr "Es gibt keinen aktiven Merge zum Abbrechen."

msgid "Merge aborted"
msgstr "Merge abgebrochen"

msgid "Abort Merge Failed"
msgstr "Merge konnte nicht abgebrochen werden"

msgid "Rename Branch"
msgstr "Branch umbenennen"

msgid "Renaming a branch changes its local name without changing its commits."
msgstr "Das Umbenennen eines Branches ändert nur seinen lokalen Namen, nicht seine Commits."

msgid "Rename"
msgstr "Umbenennen"

msgid "This removes the local branch reference. Git Desk uses Git’s safe deletion, so Git will refuse if it considers the branch not fully merged."
msgstr "Dadurch wird die lokale Branch-Referenz entfernt. Git Desk verwendet Gits sichere Löschung; Git verweigert sie, wenn der Branch als nicht vollständig gemergt gilt."

msgid "Delete Branch"
msgstr "Branch löschen"

msgid "Type"
msgstr "Typ"

msgid "Status"
msgstr "Status"

msgid "Not checked out"
msgstr "Nicht ausgecheckt"

msgid "Not configured"
msgstr "Nicht konfiguriert"

msgid "Upstream"
msgstr "Upstream"

msgid "origin"
msgstr "origin"

msgid "https://github.com/user/repository.git"
msgstr "https://github.com/user/repository.git"

msgid "Add Remote"
msgstr "Remote hinzufügen"

msgid "Connect this repository to another Git repository. Enter a remote name and URL."
msgstr "Verbinde dieses Repository mit einem anderen Git-Repository. Gib einen Remote-Namen und eine URL ein."

msgid "Remove Remote…"
msgstr "Remote entfernen…"

msgid "Remote actions"
msgstr "Remote-Aktionen"

msgid "No remotes configured"
msgstr "Keine Remotes konfiguriert"

msgid "Add a remote to connect this repository to GitHub, GitLab, Codeberg, or another Git server."
msgstr "Füge ein Remote hinzu, um dieses Repository mit GitHub, GitLab, Codeberg oder einem anderen Git-Server zu verbinden."

msgid "Remove Remote"
msgstr "Remote entfernen"

msgid "No saved stashes"
msgstr "Keine gespeicherten Stashes"

msgid "Loading stash…"
msgstr "Stash wird geladen…"

msgid "This stash has no visible diff."
msgstr "Dieser Stash hat keinen sichtbaren Diff."

msgid "Temporarily save staged and working-tree changes."
msgstr "Speichere vorgemerkte Änderungen und Änderungen im Arbeitsbaum vorübergehend."

msgid "Create the first commit before using Stash."
msgstr "Erstelle den ersten Commit, bevor du Stash verwendest."

msgid "Optional stash message"
