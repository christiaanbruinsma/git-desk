"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Easy to start. Powerful enough to stay."
msgstr "Easy to start. Powerful enough to stay."

msgid "Git Desk"
msgstr "Git Desk"

msgid "https://github.com/owner/repository.git"
msgstr "https://github.com/owner/repository.git"

msgid "Clone Repository"
msgstr "Clonar repositório"

msgid "Enter a Git repository URL. Git Desk will then ask where to create the cloned repository."
msgstr "Introduza o URL de um repositório Git. O Git Desk perguntará depois onde criar o repositório clonado."

msgid "Cancel"
msgstr "Cancelar"

msgid "Continue"
msgstr "Continuar"

msgid "Choose Location for Cloned Repository"
msgstr "Escolher localização do repositório clonado"

msgid "Choose Project Folder"
msgstr "Escolher pasta do projeto"

msgid "Open Project"
msgstr "Abrir projeto"

msgid "project"
msgstr "projeto"

msgid "Project folder not found"
msgstr "Pasta do projeto não encontrada"

msgid "Remove from Recent Projects"
msgstr "Remover dos projetos recentes"

msgid "Locate Project…"
msgstr "Localizar projeto…"

msgid "Locate Project"
msgstr "Localizar projeto"

msgid "Close"
msgstr "Fechar"

msgid "Git Desk can’t find {name} at its saved location. The folder may have been moved or deleted."
msgstr "O Git Desk não encontra {name} na localização guardada. A pasta pode ter sido movida ou eliminada."

msgid "No textual diff available."
msgstr "Nenhum diff textual disponível."

msgid "Repository"
msgstr "Repositório"

msgid "Back to projects"
msgstr "Voltar aos projetos"

msgid "Local project folder"
msgstr "Pasta local do projeto"

msgid "Open Repository Folder"
msgstr "Abrir pasta do repositório"

msgid "Refresh repository"
msgstr "Atualizar repositório"

msgid "Push"
msgstr "Push"

msgid "Pull"
msgstr "Pull"

msgid "Fetch"
msgstr "Fetch"

msgid "Inspector"
msgstr "Inspetor"

msgid "Select an item to inspect it."
msgstr "Selecione um item para inspecionar."

msgid "Edit Message…"
msgstr "Editar mensagem…"

msgid "Change the message of this unpublished commit without including staged changes."
msgstr "Altere a mensagem deste commit não publicado sem incluir as alterações em stage."

msgid "Amend"
msgstr "Amend"

msgid "Add all currently staged changes to this unpublished commit."
msgstr "Adicione todas as alterações atualmente em stage a este commit não publicado."

msgid "Undo Commit"
msgstr "Desfazer commit"

msgid "Remove this unpublished commit from the branch and return its contents to staging."
msgstr "Remova este commit não publicado da branch e devolva o conteúdo ao staging."

msgid "Revert Commit…"
msgstr "Reverter commit…"

msgid "Create a new commit that reverses this commit on the current branch."
msgstr "Crie um novo commit que reverta este commit na branch atual."

msgid "Cherry-pick…"
msgstr "Cherry-pick…"

msgid "Apply this commit on top of the current branch as a new commit."
msgstr "Aplique este commit sobre a branch atual como um novo commit."

msgid "Nothing selected"
msgstr "Nada selecionado"

msgid "Select a change, commit, branch, stash, or tag to inspect its details."
msgstr "Selecione uma alteração, commit, branch, stash ou tag para ver os detalhes."

msgid "Apply"
msgstr "Aplicar"

msgid "Apply this stash to the working tree and keep it in the stash list."
msgstr "Aplique este stash à árvore de trabalho e mantenha-o na lista de stashes."

msgid "Pop"
msgstr "Pop"

msgid "Apply this stash and remove it from the stash list when successful."
msgstr "Aplique este stash e remova-o da lista se a operação for bem-sucedida."

msgid "Delete Stash"
msgstr "Eliminar stash"

msgid "Permanently remove this saved stash without applying it."
msgstr "Remova permanentemente este stash guardado sem o aplicar."

msgid "Push Tag…"
msgstr "Enviar tag…"

msgid "Push exactly this tag to one configured remote without force-updating an existing remote tag."
msgstr "Faça push apenas desta tag para um remoto configurado sem forçar a atualização de uma tag remota existente."

msgid "Delete Tag…"
msgstr "Eliminar tag…"

msgid "Delete this local tag. Tags already present on remotes are not deleted."
msgstr "Elimine esta tag local. As tags já existentes nos remotos não são eliminadas."

msgid "Expand Inspector"
msgstr "Expandir inspetor"

msgid "Restore Inspector Width"
msgstr "Restaurar largura do inspetor"

msgid "Could Not Open Repository Folder"
msgstr "Não foi possível abrir a pasta do repositório"

msgid "Could Not Open Files"
msgstr "Não foi possível abrir os ficheiros"

msgid "Working tree clean"
msgstr "Árvore de trabalho limpa"

msgid "Resolve conflicted files individually before staging all changes."
msgstr "Resolva individualmente os ficheiros em conflito antes de colocar todas as alterações em stage."

msgid "Stage all working-tree changes"
msgstr "Colocar todas as alterações em stage"

msgid "Conflict · resolve the file, then mark resolved"
msgstr "Conflito · resolva o ficheiro e depois marque-o como resolvido"

msgid "Unstage"
msgstr "Retirar do stage"

msgid "Mark Resolved"
msgstr "Marcar como resolvido"

msgid "Stage"
msgstr "Stage"

msgid "Stage this resolved file so Git can continue the current operation."
msgstr "Coloque este ficheiro resolvido em stage para que o Git possa continuar a operação atual."

msgid "Delete Untracked File…"
msgstr "Eliminar ficheiro não rastreado…"

msgid "Discard Changes…"
msgstr "Descartar alterações…"

msgid "Show Parent Folder in Files"
msgstr "Mostrar pasta superior em Ficheiros"

msgid "Show in Files"
msgstr "Mostrar em Ficheiros"

msgid "Actions"
msgstr "Ações"

msgid "Change actions"
msgstr "Ações da alteração"

msgid "This file is not tracked by Git. Deleting it cannot be undone by Git Desk."
msgstr "Este ficheiro não é rastreado pelo Git. O Git Desk não pode anular a sua eliminação."

msgid "The working-tree version will be restored from Git’s index. Any staged version is kept. This cannot be undone by Git Desk."
msgstr "A versão da árvore de trabalho será restaurada a partir do índice do Git. Qualquer versão em stage será mantida. O Git Desk não pode anular esta ação."

msgid "Delete File"
msgstr "Eliminar ficheiro"

msgid "Discard Changes"
msgstr "Descartar alterações"

msgid "Ready to commit"
msgstr "Pronto para commit"

msgid "Working tree"
msgstr "Árvore de trabalho"

msgid "Merge commits require choosing an explicit mainline parent. Git Desk does not guess that parent."
msgstr "Os commits de merge exigem a escolha explícita de um parent principal. O Git Desk não tenta adivinhá-lo."

msgid "Switch to a normal branch with a clean working tree before applying a history action."
msgstr "Mude para uma branch normal com a árvore de trabalho limpa antes de aplicar uma ação de histórico."

msgid "Finish or abort the current history operation first."
msgstr "Conclua ou aborte primeiro a operação de histórico atual."

msgid "Create a new commit on the current branch without rewriting existing history."
msgstr "Crie um novo commit na branch atual sem reescrever o histórico existente."

msgid "Switch to a normal branch with a clean working tree before cherry-picking a commit."
msgstr "Mude para uma branch normal com a árvore de trabalho limpa antes de fazer cherry-pick de um commit."

msgid "Stage changes first to amend this unpublished commit."
msgstr "Coloque primeiro alterações em stage para alterar este commit não publicado."

msgid "Could Not Load Commit Message"
msgstr "Não foi possível carregar a mensagem do commit"

msgid "Edit Commit Message"
msgstr "Editar mensagem do commit"

msgid "Change the message of this unpublished commit. Currently staged changes will not be included."
msgstr "Altere a mensagem deste commit não publicado. As alterações atualmente em stage não serão incluídas."

msgid "Save Message"
msgstr "Guardar mensagem"

msgid "Commit message updated"
msgstr "Mensagem do commit atualizada"

msgid "Could Not Edit Commit"
msgstr "Não foi possível editar o commit"

msgid "Amend Unpublished Commit?"
msgstr "Alterar o commit não publicado?"

msgid "Add all currently staged changes to this commit? Its commit ID will change. Nothing will be pushed automatically."
msgstr "Adicionar todas as alterações atualmente em stage a este commit? O ID do commit será alterado. Nada será enviado automaticamente."

msgid "Amend Commit"
msgstr "Alterar commit"

msgid "Staged changes amended into commit"
msgstr "Alterações em stage incorporadas no commit"

msgid "Could Not Amend Commit"
msgstr "Não foi possível alterar o commit"

msgid "Undo Unpublished Commit?"
msgstr "Anular o commit não publicado?"

msgid "Remove this commit from the branch and return its contents to the staging area? No files will be deleted. Existing staged changes remain staged."
msgstr "Remover este commit da branch e devolver o conteúdo ao staging? Nenhum ficheiro será eliminado. As alterações já em stage permanecem em stage."

msgid "Commit undone — changes returned to staging"
msgstr "Commit anulado — alterações devolvidas ao staging"

msgid "Could Not Undo Commit"
msgstr "Não foi possível anular o commit"

msgid "History Operation Already in Progress"
msgstr "Já existe uma operação de histórico em curso"

msgid "Finish or abort the current Revert/Cherry-pick operation in Changes before starting another one."
msgstr "Conclua ou aborte a operação Revert/Cherry-pick atual em Alterações antes de iniciar outra."

msgid "Could Not Check History State"
msgstr "Não foi possível verificar o estado do histórico"

msgid "Merge in Progress"
msgstr "Merge em curso"

msgid "Complete or abort the current merge before applying a history action."
msgstr "Conclua ou aborte o merge atual antes de aplicar uma ação de histórico."

msgid "Could Not Check Merge State"
msgstr "Não foi possível verificar o estado do merge"

msgid "Could Not Read Repository Status"
msgstr "Não foi possível ler o estado do repositório"

msgid "Cannot Apply History Action Here"
msgstr "Não é possível aplicar aqui uma ação de histórico"

msgid "Switch to a normal local branch with at least one commit before reverting or cherry-picking."
msgstr "Mude para uma branch local normal com pelo menos um commit antes de fazer revert ou cherry-pick."

msgid "Commit or Stash Changes First"
msgstr "Faça primeiro commit ou stash das alterações"

msgid "Git Desk starts Revert and Cherry-pick from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "O Git Desk inicia Revert e Cherry-pick a partir de uma árvore de trabalho limpa. Faça commit do trabalho ou guarde-o em Stashes e tente novamente."

msgid "Commit Is Not on the Current Branch"
msgstr "O commit não está na branch atual"

msgid "Git Desk only reverts commits that are part of the current branch history. Use Cherry-pick when you want to apply a commit from another branch."
msgstr "O Git Desk só reverte commits que fazem parte do histórico da branch atual. Use Cherry-pick para aplicar um commit de outra branch."

msgid "Could Not Verify Commit Ancestry"
msgstr "Não foi possível verificar a ascendência do commit"

msgid "Commit Is Already HEAD"
msgstr "O commit já é HEAD"

msgid "The selected commit is already the current commit, so there is nothing to cherry-pick."
msgstr "O commit selecionado já é o commit atual, por isso não há nada para cherry-pick."

msgid "Could Not Verify Current Commit"
msgstr "Não foi possível verificar o commit atual"

msgid "Revert Commit"
msgstr "Reverter commit"

msgid "Cherry-pick Commit"
msgstr "Cherry-pick do commit"

msgid "Repository Changed"
msgstr "Repositório alterado"

msgid "The current branch or working tree changed while the confirmation was open. Review the repository and try again."
msgstr "A branch atual ou a árvore de trabalho mudou enquanto a confirmação estava aberta. Reveja o repositório e tente novamente."

msgid "Commit reverted"
msgstr "Commit revertido"

msgid "Commit cherry-picked"
msgstr "Commit aplicado por cherry-pick"

msgid "Revert"
msgstr "Revert"

msgid "Abort Revert"
msgstr "Abortar revert"

msgid "Cherry-pick"
msgstr "Cherry-pick"

msgid "Abort Cherry-pick"
msgstr "Abortar cherry-pick"

msgid "History Action Failed"
msgstr "A ação de histórico falhou"

msgid "Revert Failed"
msgstr "Revert falhou"

msgid "Cherry-pick Failed"
msgstr "Cherry-pick falhou"

msgid "History Operation Changed"
msgstr "Operação de histórico alterada"

msgid "A different history operation is now active. Refresh and review Changes before continuing."
msgstr "Está agora ativa uma operação de histórico diferente. Atualize e reveja Alterações antes de continuar."

msgid "No History Operation in Progress"
msgstr "Nenhuma operação de histórico em curso"

msgid "There is no Revert or Cherry-pick operation to continue."
msgstr "Não existe nenhuma operação Revert ou Cherry-pick para continuar."

msgid "Could Not Check Conflicts"
msgstr "Não foi possível verificar os conflitos"

msgid "Conflicts Still Need Resolution"
msgstr "Ainda existem conflitos por resolver"

msgid "Stage Remaining Changes"
msgstr "Colocar as alterações restantes em stage"

msgid "Tracked unstaged changes would not be included when the history operation continues. Stage the resolved changes first."
msgstr "As alterações rastreadas fora de stage não seriam incluídas ao continuar a operação de histórico. Coloque primeiro em stage as alterações resolvidas."

msgid "Revert completed"
msgstr "Reversão concluída"

msgid "Cherry-pick completed"
msgstr "Cherry-pick concluído"

msgid "Could Not Continue Revert"
msgstr "Não foi possível continuar o revert"

msgid "Could Not Continue Cherry-pick"
msgstr "Não foi possível continuar o cherry-pick"

msgid "A different history operation is now active. Refresh and review Changes before skipping."
msgstr "Está agora ativa uma operação de histórico diferente. Atualize e reveja Alterações antes de ignorar."

msgid "No Cherry-pick in Progress"
msgstr "Nenhum cherry-pick em curso"

msgid "There is no Cherry-pick operation to skip."
msgstr "Não existe nenhuma operação Cherry-pick para ignorar."

msgid "Cherry-pick Still Has Conflicts"
msgstr "O cherry-pick ainda tem conflitos"

msgid "Skip is only offered for an empty Cherry-pick. Resolve the conflicts or abort the operation."
msgstr "Ignorar só está disponível para um Cherry-pick vazio. Resolva os conflitos ou aborte a operação."

msgid "Cherry-pick Is No Longer Empty"
msgstr "O cherry-pick já não está vazio"

msgid "Tracked changes are present. Review and stage the resolution to continue, or abort the Cherry-pick."
msgstr "Existem alterações rastreadas. Reveja e coloque a resolução em stage para continuar, ou aborte o Cherry-pick."

msgid "Empty Cherry-pick skipped"
msgstr "Cherry-pick vazio ignorado"

msgid "Could Not Skip Cherry-pick"
msgstr "Não foi possível ignorar o cherry-pick"

msgid "Abort Current Revert?"
msgstr "Abortar o revert atual?"

msgid "Abort Current Cherry-pick?"
msgstr "Abortar o cherry-pick atual?"

msgid "A different history operation is now active. Refresh and review Changes before aborting."
msgstr "Está agora ativa uma operação de histórico diferente. Atualize e reveja Alterações antes de abortar."

msgid "There is no Revert or Cherry-pick operation to abort."
msgstr "Não existe nenhuma operação Revert ou Cherry-pick para abortar."

msgid "Abort Revert Failed"
msgstr "Falha ao abortar o revert"

msgid "Abort Cherry-pick Failed"
msgstr "Falha ao abortar o cherry-pick"

msgid "Could not load local commits not published to a configured remote."
msgstr "Não foi possível carregar os commits locais não publicados num remoto configurado."

msgid "Outgoing commits unavailable"
msgstr "Commits de saída indisponíveis"

msgid "No commits yet"
msgstr "Ainda não há commits"

msgid "Your first commit will appear here."
msgstr "O primeiro commit aparecerá aqui."

msgid "No changed files."
msgstr "Nenhum ficheiro alterado."

msgid "Current branch · merge in progress"
msgstr "Branch atual · merge em curso"

msgid "Current branch · history operation in progress"
msgstr "Branch atual · operação de histórico em curso"

msgid "Current branch · first commit not created yet"
msgstr "Branch atual · primeiro commit ainda não criado"

msgid "Current branch"
msgstr "Branch atual"

msgid "Remote branch"
msgstr "Branch remoto"

msgid "Local branch"
msgstr "Branch local"

msgid "Switch to Branch"
msgstr "Mudar para branch"

msgid "Merge into Current Branch…"
msgstr "Fazer merge na branch atual…"

msgid "Abort Merge…"
msgstr "Abortar merge…"

msgid "Unset Upstream"
msgstr "Remover upstream"

msgid "Rename Branch…"
msgstr "Renomear branch…"

msgid "Delete Branch…"
msgstr "Eliminar branch…"

msgid "Branch actions"
msgstr "Ações da branch"

msgid "Remote branch actions"
msgstr "Ações da branch remota"

msgid "No local branches yet"
msgstr "Ainda não há branches locais"

msgid "No remote branches configured"
msgstr "Nenhuma branch remota configurada"

msgid "feature/my-branch"
msgstr "feature/my-branch"

msgid "New Branch"
msgstr "Nova branch"

msgid "Create a branch from the current branch and switch to it. Uncommitted changes stay in the working tree."
msgstr "Crie uma branch a partir da branch atual e mude para ela. As alterações não commitadas permanecem na árvore de trabalho."

msgid "Create & Switch"
msgstr "Criar e mudar"

msgid "origin/main"
msgstr "origin/main"

msgid "Enter the remote branch this local branch should track, for example origin/main."
msgstr "Introduza a branch remota que esta branch local deve seguir, por exemplo origin/main."

msgid "Set Upstream"
msgstr "Definir upstream"

msgid "This repository has uncommitted changes. Git Desk will leave them in the working tree. Git may refuse the switch if the target branch would overwrite them."
msgstr "Este repositório tem alterações não commitadas. O Git Desk irá mantê-las na árvore de trabalho. O Git pode recusar a mudança se a branch de destino as substituísse."

msgid "Switch Branch"
msgstr "Mudar de branch"

msgid "Continue Revert"
msgstr "Continuar revert"

msgid "Abort Revert…"
msgstr "Abortar revert…"

msgid "Continue Cherry-pick"
msgstr "Continuar cherry-pick"

msgid "Abort Cherry-pick…"
msgstr "Abortar cherry-pick…"

msgid "Finish an empty Cherry-pick without creating a commit."
msgstr "Concluir um cherry-pick vazio sem criar um commit."

msgid "Continue the current Git history operation using the staged resolution."
msgstr "Continuar a operação atual do histórico do Git usando a resolução em stage."

msgid "Git Desk must verify the conflict state before continuing."
msgstr "O Git Desk tem de verificar o estado dos conflitos antes de continuar."

msgid "Git Desk must verify the working tree state before continuing."
msgstr "O Git Desk tem de verificar o estado da árvore de trabalho antes de continuar."

msgid "Resolve and mark every conflicted file before continuing."
msgstr "Resolva e marque cada ficheiro em conflito antes de continuar."

msgid "There are no tracked changes to commit. Skip the empty Cherry-pick."
msgstr "Não existem alterações rastreadas para commit. Ignore o cherry-pick vazio."

msgid "Stage the remaining tracked changes before continuing."
msgstr "Coloque em stage as alterações rastreadas restantes antes de continuar."

msgid "Git Desk could not verify the conflict state. Refresh the repository or abort the merge."
msgstr "O Git Desk não conseguiu verificar o estado dos conflitos. Atualize o repositório ou aborte o merge."

msgid "Conflicts are resolved, but tracked unstaged changes remain. Stage them before completing the merge."
msgstr "Os conflitos estão resolvidos, mas restam alterações rastreadas fora de stage. Coloque-as em stage antes de concluir o merge."

msgid "All conflicts are resolved and staged. Complete the merge to create the merge commit."
msgstr "Todos os conflitos estão resolvidos e em stage. Conclua o merge para criar o commit de merge."

msgid "Create the merge commit using Git’s prepared merge message."
msgstr "Crie o commit de merge usando a mensagem de merge preparada pelo Git."

msgid "Git Desk must verify the conflict state before completing the merge."
msgstr "O Git Desk tem de verificar o estado dos conflitos antes de concluir o merge."

msgid "Resolve and mark every conflicted file before completing the merge."
msgstr "Resolva e marque cada ficheiro em conflito antes de concluir o merge."

msgid "Stage the remaining tracked changes before completing the merge."
msgstr "Coloque em stage as alterações rastreadas restantes antes de concluir o merge."

msgid "No Merge in Progress"
msgstr "Nenhum merge em curso"

msgid "There is no active merge to complete."
msgstr "Não existe nenhum merge ativo para concluir."

msgid "Tracked unstaged changes would not be included in the merge commit. Stage them first, then complete the merge."
msgstr "As alterações rastreadas fora de stage não seriam incluídas no commit de merge. Coloque-as primeiro em stage e depois conclua o merge."

msgid "Merge completed"
msgstr "Merge concluído"

msgid "Complete Merge Failed"
msgstr "Falha ao concluir o merge"

msgid "Merge Already in Progress"
msgstr "Merge já em curso"

msgid "Finish the current merge or abort it before starting another one."
msgstr "Conclua o merge atual ou aborte-o antes de iniciar outro."

msgid "Cannot Merge Here"
msgstr "Não é possível fazer merge aqui"

msgid "Check out a normal local branch with at least one commit before merging another branch into it."
msgstr "Mude para uma branch local normal com pelo menos um commit antes de fazer merge de outra branch nela."

msgid "Git Desk only starts a branch merge from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "O Git Desk só inicia um merge de branches a partir de uma árvore de trabalho limpa. Faça commit do trabalho ou guarde-o em Stashes e tente novamente."

msgid "Git will fast-forward when possible. Otherwise it will create a merge commit. If conflicts occur, Git Desk will keep the merge open so you can resolve the files in Changes or abort the merge from Branches."
msgstr "O Git fará fast-forward quando possível. Caso contrário, criará um commit de merge. Se ocorrerem conflitos, o Git Desk manterá o merge aberto para que possa resolver os ficheiros em Alterações ou abortar o merge em Branches."

msgid "Merge Branch"
msgstr "Fazer merge da branch"

msgid "The current branch or working tree changed while the merge confirmation was open. Review the repository and try again."
msgstr "A branch atual ou a árvore de trabalho mudou enquanto a confirmação do merge estava aberta. Reveja o repositório e tente novamente."

msgid "Merge Failed"
msgstr "Merge falhou"

msgid "Abort Current Merge?"
msgstr "Abortar o merge atual?"

msgid "Discard the changes created by the current merge attempt and restore the branch to its pre-merge state?"
msgstr "Descartar as alterações criadas pela tentativa de merge atual e restaurar a branch ao estado anterior ao merge?"

msgid "Abort Merge"
msgstr "Abortar merge"

msgid "There is no active merge to abort."
msgstr "Não existe nenhum merge ativo para abortar."

msgid "Merge aborted"
msgstr "Merge abortado"

msgid "Abort Merge Failed"
msgstr "Falha ao abortar o merge"

msgid "Rename Branch"
msgstr "Renomear branch"

msgid "Renaming a branch changes its local name without changing its commits."
msgstr "Renomear uma branch altera o nome local sem alterar os commits."

msgid "Rename"
msgstr "Renomear"

msgid "This removes the local branch reference. Git Desk uses Git’s safe deletion, so Git will refuse if it considers the branch not fully merged."
msgstr "Isto remove a referência da branch local. O Git Desk usa a eliminação segura do Git, por isso o Git recusará se considerar que a branch não foi totalmente integrada."

msgid "Delete Branch"
msgstr "Eliminar branch"

msgid "Type"
msgstr "Tipo"

msgid "Status"
msgstr "Estado"

msgid "Not checked out"
msgstr "Não ativa"

msgid "Not configured"
msgstr "Não configurado"

msgid "Upstream"
msgstr "Upstream"

msgid "origin"
msgstr "origin"

msgid "https://github.com/user/repository.git"
msgstr "https://github.com/user/repository.git"

msgid "Add Remote"
msgstr "Adicionar remoto"

msgid "Connect this repository to another Git repository. Enter a remote name and URL."
msgstr "Ligue este repositório a outro repositório Git. Introduza um nome de remoto e um URL."

msgid "Remove Remote…"
msgstr "Remover remoto…"

msgid "Remote actions"
msgstr "Ações do remoto"

msgid "No remotes configured"
msgstr "Nenhum remoto configurado"

msgid "Add a remote to connect this repository to GitHub, GitLab, Codeberg, or another Git server."
msgstr "Adicione um remoto para ligar este repositório ao GitHub, GitLab, Codeberg ou outro servidor Git."

msgid "Remove Remote"
msgstr "Remover remoto"

msgid "No saved stashes"
msgstr "Nenhum stash guardado"

msgid "Loading stash…"
msgstr "A carregar stash…"

msgid "This stash has no visible diff."
msgstr "Este stash não tem diff visível."

msgid "Temporarily save staged and working-tree changes."
msgstr "Guarde temporariamente as alterações em stage e na árvore de trabalho."

msgid "Create the first commit before using Stash."
msgstr "Crie o primeiro commit antes de usar Stash."

msgid "Optional stash message"
msgstr "Mensagem de stash opcional"

msgid "Include untracked files"
msgstr "Incluir ficheiros não rastreados"

msgid "Stash Changes"
msgstr "Guardar alterações em stash"

msgid "Temporarily save your current staged and working-tree changes, then return to a clean working tree."
msgstr "Guarde temporariamente as alterações em stage e na árvore de trabalho e depois regresse a uma árvore de trabalho limpa."

msgid "Stash Requires a First Commit"
msgstr "Stash requer um primeiro commit"

msgid "Create the repository's first commit before using Stash."
msgstr "Crie o primeiro commit do repositório antes de usar Stash."

msgid "Stash created"
msgstr "Stash criado"

msgid "No local changes to stash"
msgstr "Nenhuma alteração local para guardar"

msgid "Stash Failed"
msgstr "Stash falhou"

msgid "Apply Stash Failed"
msgstr "Falha ao aplicar o stash"

msgid "Pop Stash?"
msgstr "Fazer pop do stash?"

msgid "Pop Stash"
msgstr "Pop do stash"

msgid "Pop Stash Failed"
msgstr "Falha ao fazer pop do stash"

msgid "Delete Stash?"
msgstr "Eliminar stash?"

msgid "Delete Stash Failed"
msgstr "Falha ao eliminar o stash"

msgid "No tags"
msgstr "Nenhuma tag"

msgid "Annotated"
msgstr "Anotada"

msgid "Lightweight"
msgstr "Leve"

msgid "Annotated tag"
msgstr "Tag anotada"

msgid "Lightweight tag"
msgstr "Tag leve"

msgid "Target Commit"
msgstr "Commit de destino"

msgid "Nothing to Tag Yet"
msgstr "Ainda não há nada para etiquetar"

msgid "Create the first commit before creating a tag."
msgstr "Crie o primeiro commit antes de criar uma tag."

msgid "Tag name, for example v1.0.0"
msgstr "Nome da tag, por exemplo v1.0.0"

msgid "Optional tag message"
msgstr "Mensagem de tag opcional"

msgid "Add a message for an annotated tag. Leave it blank for a lightweight tag."
msgstr "Adicione uma mensagem para uma tag anotada. Deixe em branco para uma tag lightweight."

