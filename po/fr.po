msgstr ""
"Project-Id-Version: git-desk 0.9.0\n"
"PO-Revision-Date: 2026-08-16 00:36+0200\n"
"Last-Translator: Christiaan Bruinsma\n"
"Language-Team: Français\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

msgid "Easy to start. Powerful enough to stay."
msgstr "Easy to start. Powerful enough to stay."

msgid "Git Desk"
msgstr "Git Desk"

msgid "https://github.com/owner/repository.git"
msgstr "https://github.com/owner/repository.git"

msgid "Clone Repository"
msgstr "Cloner le dépôt"

msgid "Enter a Git repository URL. Git Desk will then ask where to create the cloned repository."
msgstr "Saisissez l’URL d’un dépôt Git. Git Desk vous demandera ensuite où créer le dépôt cloné."

msgid "Cancel"
msgstr "Annuler"

msgid "Continue"
msgstr "Continuer"

msgid "Choose Location for Cloned Repository"
msgstr "Choisir l’emplacement du dépôt cloné"

msgid "Choose Project Folder"
msgstr "Choisir le dossier du projet"

msgid "Open Project"
msgstr "Ouvrir le projet"

msgid "project"
msgstr "projet"

msgid "Project folder not found"
msgstr "Dossier du projet introuvable"

msgid "Remove from Recent Projects"
msgstr "Retirer des projets récents"

msgid "Locate Project…"
msgstr "Localiser le projet…"

msgid "Locate Project"
msgstr "Localiser le projet"

msgid "Close"
msgstr "Fermer"

msgid "Git Desk can’t find {name} at its saved location. The folder may have been moved or deleted."
msgstr "Git Desk ne trouve pas {name} à l’emplacement enregistré. Le dossier a peut-être été déplacé ou supprimé."

msgid "No textual diff available."
msgstr "Aucun diff textuel disponible."

msgid "Repository"
msgstr "Dépôt"

msgid "Back to projects"
msgstr "Retour aux projets"

msgid "Local project folder"
msgstr "Dossier de projet local"

msgid "Open Repository Folder"
msgstr "Ouvrir le dossier du dépôt"

msgid "Refresh repository"
msgstr "Actualiser le dépôt"

msgid "Push"
msgstr "Push"

msgid "Pull"
msgstr "Pull"

msgid "Fetch"
msgstr "Fetch"

msgid "Inspector"
msgstr "Inspecteur"

msgid "Select an item to inspect it."
msgstr "Sélectionnez un élément à inspecter."

msgid "Edit Message…"
msgstr "Modifier le message…"

msgid "Change the message of this unpublished commit without including staged changes."
msgstr "Modifiez le message de ce commit non publié sans inclure les changements indexés."

msgid "Amend"
msgstr "Amender"

msgid "Add all currently staged changes to this unpublished commit."
msgstr "Ajoutez tous les changements actuellement indexés à ce commit non publié."

msgid "Undo Commit"
msgstr "Annuler le commit"

msgid "Remove this unpublished commit from the branch and return its contents to staging."
msgstr "Retirez ce commit non publié de la branche et replacez son contenu dans l’index."

msgid "Revert Commit…"
msgstr "Rétablir le commit…"

msgid "Create a new commit that reverses this commit on the current branch."
msgstr "Créez un nouveau commit qui annule ce commit sur la branche actuelle."

msgid "Cherry-pick…"
msgstr "Cherry-pick…"

msgid "Apply this commit on top of the current branch as a new commit."
msgstr "Appliquez ce commit au-dessus de la branche actuelle en tant que nouveau commit."

msgid "Nothing selected"
msgstr "Aucune sélection"

msgid "Select a change, commit, branch, stash, or tag to inspect its details."
msgstr "Sélectionnez une modification, un commit, une branche, un stash ou un tag pour en voir les détails."

msgid "Apply"
msgstr "Appliquer"

msgid "Apply this stash to the working tree and keep it in the stash list."
msgstr "Appliquez ce stash à l’arbre de travail et conservez-le dans la liste des stashs."

msgid "Pop"
msgstr "Pop"

msgid "Apply this stash and remove it from the stash list when successful."
msgstr "Appliquez ce stash et retirez-le de la liste si l’opération réussit."

msgid "Delete Stash"
msgstr "Supprimer le stash"

msgid "Permanently remove this saved stash without applying it."
msgstr "Supprimez définitivement ce stash enregistré sans l’appliquer."

msgid "Push Tag…"
msgstr "Pousser le tag…"

msgid "Push exactly this tag to one configured remote without force-updating an existing remote tag."
msgstr "Poussez uniquement ce tag vers un remote configuré sans forcer la mise à jour d’un tag distant existant."

msgid "Delete Tag…"
msgstr "Supprimer le tag…"

msgid "Delete this local tag. Tags already present on remotes are not deleted."
msgstr "Supprimez ce tag local. Les tags déjà présents sur les remotes ne sont pas supprimés."

msgid "Expand Inspector"
msgstr "Agrandir l’inspecteur"

msgid "Restore Inspector Width"
msgstr "Restaurer la largeur de l’inspecteur"

msgid "Could Not Open Repository Folder"
msgstr "Impossible d’ouvrir le dossier du dépôt"

msgid "Could Not Open Files"
msgstr "Impossible d’ouvrir les fichiers"

msgid "Working tree clean"
msgstr "Arbre de travail propre"

msgid "Resolve conflicted files individually before staging all changes."
msgstr "Résolvez les fichiers en conflit individuellement avant d’indexer tous les changements."

msgid "Stage all working-tree changes"
msgstr "Indexer toutes les modifications"

msgid "Conflict · resolve the file, then mark resolved"
msgstr "Conflit · résolvez le fichier puis marquez-le comme résolu"

msgid "Unstage"
msgstr "Désindexer"

msgid "Mark Resolved"
msgstr "Marquer comme résolu"

msgid "Stage"
msgstr "Indexer"

msgid "Stage this resolved file so Git can continue the current operation."
msgstr "Indexez ce fichier résolu afin que Git puisse poursuivre l’opération actuelle."

msgid "Delete Untracked File…"
msgstr "Supprimer le fichier non suivi…"

msgid "Discard Changes…"
msgstr "Abandonner les modifications…"

msgid "Show Parent Folder in Files"
msgstr "Afficher le dossier parent dans Fichiers"

msgid "Show in Files"
msgstr "Afficher dans Fichiers"

msgid "Actions"
msgstr "Actions"

msgid "Change actions"
msgstr "Actions de modification"

msgid "This file is not tracked by Git. Deleting it cannot be undone by Git Desk."
msgstr "Ce fichier n’est pas suivi par Git. Git Desk ne pourra pas annuler sa suppression."

msgid "The working-tree version will be restored from Git’s index. Any staged version is kept. This cannot be undone by Git Desk."
msgstr "La version de l’arbre de travail sera restaurée depuis l’index Git. Toute version indexée est conservée. Git Desk ne peut pas annuler cette action."

msgid "Delete File"
msgstr "Supprimer le fichier"

msgid "Discard Changes"
msgstr "Abandonner les modifications"

msgid "Ready to commit"
msgstr "Prêt à valider"

msgid "Working tree"
msgstr "Arbre de travail"

msgid "Merge commits require choosing an explicit mainline parent. Git Desk does not guess that parent."
msgstr "Les commits de merge nécessitent de choisir explicitement un parent principal. Git Desk ne devine pas ce parent."

msgid "Switch to a normal branch with a clean working tree before applying a history action."
msgstr "Passez sur une branche normale avec un arbre de travail propre avant d’appliquer une action d’historique."

msgid "Finish or abort the current history operation first."
msgstr "Terminez ou abandonnez d’abord l’opération d’historique en cours."

msgid "Create a new commit on the current branch without rewriting existing history."
msgstr "Créez un nouveau commit sur la branche actuelle sans réécrire l’historique existant."

msgid "Switch to a normal branch with a clean working tree before cherry-picking a commit."
msgstr "Passez sur une branche normale avec un arbre de travail propre avant d’effectuer le cherry-pick d’un commit."

msgid "Stage changes first to amend this unpublished commit."
msgstr "Indexez d’abord des changements pour modifier ce commit non publié."

msgid "Could Not Load Commit Message"
msgstr "Impossible de charger le message du commit"

msgid "Edit Commit Message"
msgstr "Modifier le message du commit"

msgid "Change the message of this unpublished commit. Currently staged changes will not be included."
msgstr "Modifiez le message de ce commit non publié. Les changements actuellement indexés ne seront pas inclus."

msgid "Save Message"
msgstr "Enregistrer le message"

msgid "Commit message updated"
msgstr "Message du commit mis à jour"

msgid "Could Not Edit Commit"
msgstr "Impossible de modifier le commit"

msgid "Amend Unpublished Commit?"
msgstr "Modifier le commit non publié ?"

msgid "Add all currently staged changes to this commit? Its commit ID will change. Nothing will be pushed automatically."
msgstr "Ajouter tous les changements actuellement indexés à ce commit ? Son identifiant changera. Rien ne sera poussé automatiquement."

msgid "Amend Commit"
msgstr "Amender le commit"

msgid "Staged changes amended into commit"
msgstr "Changements indexés intégrés au commit"

msgid "Could Not Amend Commit"
msgstr "Impossible de modifier le commit"

msgid "Undo Unpublished Commit?"
msgstr "Annuler le commit non publié ?"

msgid "Remove this commit from the branch and return its contents to the staging area? No files will be deleted. Existing staged changes remain staged."
msgstr "Retirer ce commit de la branche et replacer son contenu dans l’index ? Aucun fichier ne sera supprimé. Les changements déjà indexés le resteront."

msgid "Commit undone — changes returned to staging"
msgstr "Commit annulé — changements replacés dans l’index"

msgid "Could Not Undo Commit"
msgstr "Impossible d’annuler le commit"

msgid "History Operation Already in Progress"
msgstr "Une opération d’historique est déjà en cours"

msgid "Finish or abort the current Revert/Cherry-pick operation in Changes before starting another one."
msgstr "Terminez ou abandonnez l’opération Revert/Cherry-pick actuelle dans Changements avant d’en démarrer une autre."

msgid "Could Not Check History State"
msgstr "Impossible de vérifier l’état de l’historique"

msgid "Merge in Progress"
msgstr "Fusion en cours"

msgid "Complete or abort the current merge before applying a history action."
msgstr "Terminez ou abandonnez le merge actuel avant d’appliquer une action d’historique."

msgid "Could Not Check Merge State"
msgstr "Impossible de vérifier l’état du merge"

msgid "Could Not Read Repository Status"
msgstr "Impossible de lire l’état du dépôt"

msgid "Cannot Apply History Action Here"
msgstr "Impossible d’appliquer une action d’historique ici"

msgid "Switch to a normal local branch with at least one commit before reverting or cherry-picking."
msgstr "Passez sur une branche locale normale contenant au moins un commit avant d’effectuer un revert ou un cherry-pick."

msgid "Commit or Stash Changes First"
msgstr "Validez ou stashz d’abord les changements"

msgid "Git Desk starts Revert and Cherry-pick from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk démarre Revert et Cherry-pick depuis un arbre de travail propre. Validez votre travail ou enregistrez-le dans Stashs, puis réessayez."

msgid "Commit Is Not on the Current Branch"
msgstr "Le commit n’appartient pas à la branche actuelle"

msgid "Git Desk only reverts commits that are part of the current branch history. Use Cherry-pick when you want to apply a commit from another branch."
msgstr "Git Desk n’annule que les commits appartenant à l’historique de la branche actuelle. Utilisez Cherry-pick pour appliquer un commit provenant d’une autre branche."

msgid "Could Not Verify Commit Ancestry"
msgstr "Impossible de vérifier l’ascendance du commit"

msgid "Commit Is Already HEAD"
msgstr "Le commit est déjà HEAD"

msgid "The selected commit is already the current commit, so there is nothing to cherry-pick."
msgstr "Le commit sélectionné est déjà le commit actuel ; il n’y a donc rien à cherry-pick."

msgid "Could Not Verify Current Commit"
msgstr "Impossible de vérifier le commit actuel"

msgid "Revert Commit"
msgstr "Annuler le commit"

msgid "Cherry-pick Commit"
msgstr "Cherry-pick du commit"

msgid "Repository Changed"
msgstr "Dépôt modifié"

msgid "The current branch or working tree changed while the confirmation was open. Review the repository and try again."
msgstr "La branche actuelle ou l’arbre de travail a changé pendant l’affichage de la confirmation. Vérifiez le dépôt et réessayez."

msgid "Commit reverted"
msgstr "Commit rétabli"

msgid "Commit cherry-picked"
msgstr "Commit appliqué par cherry-pick"

msgid "Revert"
msgstr "Revert"

msgid "Abort Revert"
msgstr "Abandonner le revert"

msgid "Cherry-pick"
msgstr "Cherry-pick"

msgid "Abort Cherry-pick"
msgstr "Abandonner le cherry-pick"

msgid "History Action Failed"
msgstr "Échec de l’action d’historique"

msgid "Revert Failed"
msgstr "Échec du revert"

msgid "Cherry-pick Failed"
msgstr "Échec du cherry-pick"

msgid "History Operation Changed"
msgstr "Opération d’historique modifiée"

msgid "A different history operation is now active. Refresh and review Changes before continuing."
msgstr "Une autre opération d’historique est maintenant active. Actualisez et vérifiez Changements avant de continuer."

msgid "No History Operation in Progress"
msgstr "Aucune opération d’historique en cours"

msgid "There is no Revert or Cherry-pick operation to continue."
msgstr "Aucune opération Revert ou Cherry-pick ne peut être poursuivie."

msgid "Could Not Check Conflicts"
msgstr "Impossible de vérifier les conflits"

msgid "Conflicts Still Need Resolution"
msgstr "Des conflits doivent encore être résolus"

msgid "Stage Remaining Changes"
msgstr "Indexer les changements restants"

msgid "Tracked unstaged changes would not be included when the history operation continues. Stage the resolved changes first."
msgstr "Les changements suivis non indexés ne seraient pas inclus lors de la poursuite de l’opération. Indexez d’abord les changements résolus."

msgid "Revert completed"
msgstr "Rétablissement terminé"

msgid "Cherry-pick completed"
msgstr "Cherry-pick terminé"

msgid "Could Not Continue Revert"
msgstr "Impossible de poursuivre le revert"

msgid "Could Not Continue Cherry-pick"
msgstr "Impossible de poursuivre le cherry-pick"

msgid "A different history operation is now active. Refresh and review Changes before skipping."
msgstr "Une autre opération d’historique est maintenant active. Actualisez et vérifiez Changements avant d’ignorer."

msgid "No Cherry-pick in Progress"
msgstr "Aucun cherry-pick en cours"

msgid "There is no Cherry-pick operation to skip."
msgstr "Aucune opération Cherry-pick ne peut être ignorée."

msgid "Cherry-pick Still Has Conflicts"
msgstr "Le cherry-pick contient encore des conflits"

msgid "Skip is only offered for an empty Cherry-pick. Resolve the conflicts or abort the operation."
msgstr "Ignorer n’est disponible que pour un Cherry-pick vide. Résolvez les conflits ou abandonnez l’opération."

msgid "Cherry-pick Is No Longer Empty"
msgstr "Le cherry-pick n’est plus vide"

msgid "Tracked changes are present. Review and stage the resolution to continue, or abort the Cherry-pick."
msgstr "Des changements suivis sont présents. Vérifiez et indexez la résolution pour continuer, ou abandonnez le Cherry-pick."

msgid "Empty Cherry-pick skipped"
msgstr "Cherry-pick vide ignoré"

msgid "Could Not Skip Cherry-pick"
msgstr "Impossible d’ignorer le cherry-pick"

msgid "Abort Current Revert?"
msgstr "Abandonner le revert en cours ?"

msgid "Abort Current Cherry-pick?"
msgstr "Abandonner le cherry-pick en cours ?"

msgid "A different history operation is now active. Refresh and review Changes before aborting."
msgstr "Une autre opération d’historique est maintenant active. Actualisez et vérifiez Changements avant d’abandonner."

msgid "There is no Revert or Cherry-pick operation to abort."
msgstr "Aucune opération Revert ou Cherry-pick ne peut être abandonnée."

msgid "Abort Revert Failed"
msgstr "Échec de l’abandon du revert"

msgid "Abort Cherry-pick Failed"
msgstr "Échec de l’abandon du cherry-pick"

msgid "Could not load local commits not published to a configured remote."
msgstr "Impossible de charger les commits locaux non publiés vers un remote configuré."

msgid "Outgoing commits unavailable"
msgstr "Commits sortants indisponibles"

msgid "No commits yet"
msgstr "Aucun commit"

msgid "Your first commit will appear here."
msgstr "Votre premier commit apparaîtra ici."

msgid "No changed files."
msgstr "Aucun fichier modifié."

msgid "Current branch · merge in progress"
msgstr "Branche actuelle · merge en cours"

msgid "Current branch · history operation in progress"
msgstr "Branche actuelle · opération d’historique en cours"

msgid "Current branch · first commit not created yet"
msgstr "Branche actuelle · premier commit pas encore créé"

msgid "Current branch"
msgstr "Branche actuelle"

msgid "Remote branch"
msgstr "Branche distante"

msgid "Local branch"
msgstr "Branche locale"

msgid "Switch to Branch"
msgstr "Changer de branche"

msgid "Merge into Current Branch…"
msgstr "Fusionner dans la branche actuelle…"

msgid "Abort Merge…"
msgstr "Abandonner la fusion…"

msgid "Unset Upstream"
msgstr "Retirer l’upstream"

msgid "Rename Branch…"
msgstr "Renommer la branche…"

msgid "Delete Branch…"
msgstr "Supprimer la branche…"

msgid "Branch actions"
msgstr "Actions de branche"

msgid "Remote branch actions"
msgstr "Actions de branche distante"

msgid "No local branches yet"
msgstr "Aucune branche locale"

msgid "No remote branches configured"
msgstr "Aucune branche distante configurée"

msgid "feature/my-branch"
msgstr "feature/my-branch"

msgid "New Branch"
msgstr "Nouvelle branche"

msgid "Create a branch from the current branch and switch to it. Uncommitted changes stay in the working tree."
msgstr "Créez une branche à partir de la branche actuelle et basculez dessus. Les changements non validés restent dans l’arbre de travail."

msgid "Create & Switch"
msgstr "Créer et basculer"

msgid "origin/main"
msgstr "origin/main"

msgid "Enter the remote branch this local branch should track, for example origin/main."
msgstr "Saisissez la branche distante que cette branche locale doit suivre, par exemple origin/main."

msgid "Set Upstream"
msgstr "Définir l’upstream"

msgid "This repository has uncommitted changes. Git Desk will leave them in the working tree. Git may refuse the switch if the target branch would overwrite them."
msgstr "Ce dépôt contient des changements non validés. Git Desk les laissera dans l’arbre de travail. Git peut refuser le changement de branche si la branche cible les écraserait."

msgid "Switch Branch"
msgstr "Changer de branche"

msgid "Continue Revert"
msgstr "Poursuivre le revert"

msgid "Abort Revert…"
msgstr "Abandonner le revert…"

msgid "Continue Cherry-pick"
msgstr "Poursuivre le cherry-pick"

msgid "Abort Cherry-pick…"
msgstr "Abandonner le cherry-pick…"

msgid "Finish an empty Cherry-pick without creating a commit."
msgstr "Terminer un cherry-pick vide sans créer de commit."

msgid "Continue the current Git history operation using the staged resolution."
msgstr "Poursuivre l’opération d’historique Git actuelle avec la résolution indexée."

msgid "Git Desk must verify the conflict state before continuing."
msgstr "Git Desk doit vérifier l’état des conflits avant de poursuivre."

msgid "Git Desk must verify the working tree state before continuing."
msgstr "Git Desk doit vérifier l’état de l’arbre de travail avant de poursuivre."

msgid "Resolve and mark every conflicted file before continuing."
msgstr "Résolvez et marquez chaque fichier en conflit comme résolu avant de poursuivre."

msgid "There are no tracked changes to commit. Skip the empty Cherry-pick."
msgstr "Aucun changement suivi n’est à valider. Ignorez le cherry-pick vide."

msgid "Stage the remaining tracked changes before continuing."
msgstr "Indexez les changements suivis restants avant de poursuivre."

msgid "Git Desk could not verify the conflict state. Refresh the repository or abort the merge."
msgstr "Git Desk n’a pas pu vérifier l’état des conflits. Actualisez le dépôt ou abandonnez la fusion."

msgid "Conflicts are resolved, but tracked unstaged changes remain. Stage them before completing the merge."
msgstr "Les conflits sont résolus, mais des changements suivis non indexés subsistent. Indexez-les avant de terminer la fusion."

msgid "All conflicts are resolved and staged. Complete the merge to create the merge commit."
msgstr "Tous les conflits sont résolus et indexés. Terminez la fusion pour créer le commit de fusion."

msgid "Create the merge commit using Git’s prepared merge message."
msgstr "Créez le commit de fusion avec le message de fusion préparé par Git."

msgid "Git Desk must verify the conflict state before completing the merge."
msgstr "Git Desk doit vérifier l’état des conflits avant de terminer la fusion."

msgid "Resolve and mark every conflicted file before completing the merge."
msgstr "Résolvez et marquez chaque fichier en conflit comme résolu avant de terminer la fusion."

msgid "Stage the remaining tracked changes before completing the merge."
msgstr "Indexez les changements suivis restants avant de terminer la fusion."

msgid "No Merge in Progress"
msgstr "Aucune fusion en cours"

msgid "There is no active merge to complete."
msgstr "Aucune fusion active ne peut être terminée."

msgid "Tracked unstaged changes would not be included in the merge commit. Stage them first, then complete the merge."
msgstr "Les changements suivis non indexés ne seraient pas inclus dans le commit de fusion. Indexez-les d’abord, puis terminez la fusion."

msgid "Merge completed"
msgstr "Fusion terminée"

msgid "Complete Merge Failed"
msgstr "Échec de la finalisation du merge"

msgid "Merge Already in Progress"
msgstr "Fusion déjà en cours"

msgid "Finish the current merge or abort it before starting another one."
msgstr "Terminez la fusion actuelle ou abandonnez-la avant d’en lancer une autre."

msgid "Cannot Merge Here"
msgstr "Fusion impossible ici"

msgid "Check out a normal local branch with at least one commit before merging another branch into it."
msgstr "Basculez vers une branche locale normale contenant au moins un commit avant d’y fusionner une autre branche."

msgid "Git Desk only starts a branch merge from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk ne lance une fusion de branche qu’avec un arbre de travail propre. Validez votre travail ou enregistrez-le dans Stashs, puis réessayez."

msgid "Git will fast-forward when possible. Otherwise it will create a merge commit. If conflicts occur, Git Desk will keep the merge open so you can resolve the files in Changes or abort the merge from Branches."
msgstr "Git effectuera un fast-forward lorsque c’est possible. Sinon, il créera un commit de merge. En cas de conflits, Git Desk laissera le merge ouvert afin que vous puissiez résoudre les fichiers dans Changements ou abandonner le merge depuis Branches."

msgid "Merge Branch"
msgstr "Fusionner la branche"

msgid "The current branch or working tree changed while the merge confirmation was open. Review the repository and try again."
msgstr "La branche actuelle ou l’arbre de travail a changé pendant l’ouverture de la confirmation de fusion. Vérifiez le dépôt et réessayez."

msgid "Merge Failed"
msgstr "Échec du merge"

msgid "Abort Current Merge?"
msgstr "Abandonner la fusion actuelle ?"

msgid "Discard the changes created by the current merge attempt and restore the branch to its pre-merge state?"
msgstr "Abandonner les changements créés par la tentative de merge actuelle et restaurer la branche dans son état antérieur au merge ?"

msgid "Abort Merge"
msgstr "Abandonner la fusion"

msgid "There is no active merge to abort."
msgstr "Aucune fusion active ne peut être abandonnée."

msgid "Merge aborted"
msgstr "Fusion abandonnée"

msgid "Abort Merge Failed"
msgstr "Échec de l’abandon du merge"

msgid "Rename Branch"
msgstr "Renommer la branche"

msgid "Renaming a branch changes its local name without changing its commits."
msgstr "Renommer une branche modifie son nom local sans modifier ses commits."

msgid "Rename"
msgstr "Renommer"

msgid "This removes the local branch reference. Git Desk uses Git’s safe deletion, so Git will refuse if it considers the branch not fully merged."
msgstr "Cela supprime la référence de branche locale. Git Desk utilise la suppression sûre de Git ; Git refusera si la branche n’est pas considérée comme entièrement mergée."

msgid "Delete Branch"
msgstr "Supprimer la branche"

msgid "Type"
msgstr "Type"

msgid "Status"
msgstr "État"

msgid "Not checked out"
msgstr "Non extraite"

msgid "Not configured"
msgstr "Non configuré"

msgid "Upstream"
msgstr "Upstream"

msgid "origin"
msgstr "origin"

msgid "https://github.com/user/repository.git"
msgstr "https://github.com/user/repository.git"

msgid "Add Remote"
msgstr "Ajouter un remote"

msgid "Connect this repository to another Git repository. Enter a remote name and URL."
msgstr "Connectez ce dépôt à un autre dépôt Git. Saisissez un nom de remote et une URL."

msgid "Remove Remote…"
msgstr "Supprimer le remote…"

msgid "Remote actions"
msgstr "Actions du remote"

msgid "No remotes configured"
msgstr "Aucun remote configuré"

msgid "Add a remote to connect this repository to GitHub, GitLab, Codeberg, or another Git server."
msgstr "Ajoutez un remote pour connecter ce dépôt à GitHub, GitLab, Codeberg ou un autre serveur Git."

msgid "Remove Remote"
msgstr "Supprimer le remote"

msgid "No saved stashes"
msgstr "Aucun stash enregistré"

msgid "Loading stash…"
msgstr "Chargement du stash…"

msgid "This stash has no visible diff."
msgstr "Ce stash ne contient aucun diff visible."

msgid "Temporarily save staged and working-tree changes."
msgstr "Enregistrez temporairement les changements indexés et ceux de l’arbre de travail."

msgid "Create the first commit before using Stash."
msgstr "Créez le premier commit avant d’utiliser Stash."

msgid "Optional stash message"
msgstr "Message de stash facultatif"

msgid "Include untracked files"
msgstr "Inclure les fichiers non suivis"

msgid "Stash Changes"
msgstr "Mettre les modifications de côté"

msgid "Temporarily save your current staged and working-tree changes, then return to a clean working tree."
msgstr "Enregistrez temporairement vos changements indexés et ceux de l’arbre de travail, puis revenez à un arbre de travail propre."

msgid "Stash Requires a First Commit"
msgstr "Stash nécessite un premier commit"

msgid "Create the repository's first commit before using Stash."
msgstr "Créez le premier commit du dépôt avant d’utiliser Stash."

msgid "Stash created"
msgstr "Stash créé"

msgid "No local changes to stash"
msgstr "Aucune modification locale à stasher"

msgid "Stash Failed"
msgstr "Échec du stash"

msgid "Apply Stash Failed"
msgstr "Échec de l’application du stash"

msgid "Pop Stash?"
msgstr "Popper le stash ?"

msgid "Pop Stash"
msgstr "Popper le stash"

msgid "Pop Stash Failed"
msgstr "Échec du pop du stash"

msgid "Delete Stash?"
msgstr "Supprimer le stash ?"

msgid "Delete Stash Failed"
msgstr "Échec de la suppression du stash"

msgid "No tags"
msgstr "Aucun tag"

msgid "Annotated"
msgstr "Annoté"

msgid "Lightweight"
msgstr "Léger"

msgid "Annotated tag"
msgstr "Tag annoté"

msgid "Lightweight tag"
msgstr "Tag léger"

msgid "Target Commit"
msgstr "Commit cible"

msgid "Nothing to Tag Yet"
