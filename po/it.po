msgstr ""
"Project-Id-Version: git-desk 0.9.0\n"
"PO-Revision-Date: 2026-08-16 00:36+0200\n"
"Last-Translator: Christiaan Bruinsma\n"
"Language-Team: Italiano\n"
"Language: it\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Easy to start. Powerful enough to stay."
msgstr "Easy to start. Powerful enough to stay."

msgid "Git Desk"
msgstr "Git Desk"

msgid "https://github.com/owner/repository.git"
msgstr "https://github.com/owner/repository.git"

msgid "Clone Repository"
msgstr "Clona repository"

msgid "Enter a Git repository URL. Git Desk will then ask where to create the cloned repository."
msgstr "Inserisci l’URL di un repository Git. Git Desk chiederà poi dove creare il repository clonato."

msgid "Cancel"
msgstr "Annulla"

msgid "Continue"
msgstr "Continua"

msgid "Choose Location for Cloned Repository"
msgstr "Scegli posizione per la repository clonata"

msgid "Choose Project Folder"
msgstr "Scegli cartella del progetto"

msgid "Open Project"
msgstr "Apri progetto"

msgid "project"
msgstr "progetto"

msgid "Project folder not found"
msgstr "Cartella del progetto non trovata"

msgid "Remove from Recent Projects"
msgstr "Rimuovi dai progetti recenti"

msgid "Locate Project…"
msgstr "Trova progetto…"

msgid "Locate Project"
msgstr "Trova progetto"

msgid "Close"
msgstr "Chiudi"

msgid "Git Desk can’t find {name} at its saved location. The folder may have been moved or deleted."
msgstr "Git Desk non trova {name} nella posizione salvata. La cartella potrebbe essere stata spostata o eliminata."

msgid "No textual diff available."
msgstr "Nessun diff testuale disponibile."

msgid "Repository"
msgstr "Repository"

msgid "Back to projects"
msgstr "Torna ai progetti"

msgid "Local project folder"
msgstr "Cartella progetto locale"

msgid "Open Repository Folder"
msgstr "Apri cartella repository"

msgid "Refresh repository"
msgstr "Aggiorna repository"

msgid "Push"
msgstr "Push"

msgid "Pull"
msgstr "Pull"

msgid "Fetch"
msgstr "Fetch"

msgid "Inspector"
msgstr "Inspector"

msgid "Select an item to inspect it."
msgstr "Seleziona un elemento da ispezionare."

msgid "Edit Message…"
msgstr "Modifica messaggio…"

msgid "Change the message of this unpublished commit without including staged changes."
msgstr "Modifica il messaggio di questo commit non pubblicato senza includere le modifiche in stage."

msgid "Amend"
msgstr "Amend"

msgid "Add all currently staged changes to this unpublished commit."
msgstr "Aggiungi tutte le modifiche attualmente in stage a questo commit non pubblicato."

msgid "Undo Commit"
msgstr "Annulla commit"

msgid "Remove this unpublished commit from the branch and return its contents to staging."
msgstr "Rimuovi questo commit non pubblicato dal branch e riporta il contenuto nello staging."

msgid "Revert Commit…"
msgstr "Ripristina commit…"

msgid "Create a new commit that reverses this commit on the current branch."
msgstr "Crea un nuovo commit che annulla questo commit sul branch corrente."

msgid "Cherry-pick…"
msgstr "Cherry-pick…"

msgid "Apply this commit on top of the current branch as a new commit."
msgstr "Applica questo commit sopra il branch corrente come nuovo commit."

msgid "Nothing selected"
msgstr "Nessuna selezione"

msgid "Select a change, commit, branch, stash, or tag to inspect its details."
msgstr "Seleziona una modifica, commit, branch, stash o tag per ispezionarne i dettagli."

msgid "Apply"
msgstr "Applica"

msgid "Apply this stash to the working tree and keep it in the stash list."
msgstr "Applica questo stash all’albero di lavoro e mantienilo nell’elenco degli stash."

msgid "Pop"
msgstr "Pop"

msgid "Apply this stash and remove it from the stash list when successful."
msgstr "Applica questo stash e rimuovilo dall’elenco se l’operazione riesce."

msgid "Delete Stash"
msgstr "Elimina stash"

msgid "Permanently remove this saved stash without applying it."
msgstr "Rimuovi definitivamente questo stash salvato senza applicarlo."

msgid "Push Tag…"
msgstr "Push tag…"

msgid "Push exactly this tag to one configured remote without force-updating an existing remote tag."
msgstr "Esegui il push solo di questo tag verso un remote configurato senza forzare l’aggiornamento di un tag remoto esistente."

msgid "Delete Tag…"
msgstr "Elimina tag…"

msgid "Delete this local tag. Tags already present on remotes are not deleted."
msgstr "Elimina questo tag locale. I tag già presenti sui remote non vengono eliminati."

msgid "Expand Inspector"
msgstr "Espandi inspector"

msgid "Restore Inspector Width"
msgstr "Ripristina larghezza ispettore"

msgid "Could Not Open Repository Folder"
msgstr "Impossibile aprire la cartella del repository"

msgid "Could Not Open Files"
msgstr "Impossibile aprire i file"

msgid "Working tree clean"
msgstr "Working tree pulito"

msgid "Resolve conflicted files individually before staging all changes."
msgstr "Risolvi singolarmente i file in conflitto prima di mettere tutte le modifiche in stage."

msgid "Stage all working-tree changes"
msgstr "Metti in stage tutte le modifiche"

msgid "Conflict · resolve the file, then mark resolved"
msgstr "Conflitto · risolvi il file e poi contrassegnalo come risolto"

msgid "Unstage"
msgstr "Rimuovi dallo stage"

msgid "Mark Resolved"
msgstr "Segna come risolto"

msgid "Stage"
msgstr "Stage"

msgid "Stage this resolved file so Git can continue the current operation."
msgstr "Metti in stage questo file risolto affinché Git possa continuare l’operazione corrente."

msgid "Delete Untracked File…"
msgstr "Elimina file non tracciato…"

msgid "Discard Changes…"
msgstr "Scarta modifiche…"

msgid "Show Parent Folder in Files"
msgstr "Mostra cartella superiore in File"

msgid "Show in Files"
msgstr "Mostra in File"

msgid "Actions"
msgstr "Azioni"

msgid "Change actions"
msgstr "Azioni modifica"

msgid "This file is not tracked by Git. Deleting it cannot be undone by Git Desk."
msgstr "Questo file non è tracciato da Git. Git Desk non può annullarne l’eliminazione."

msgid "The working-tree version will be restored from Git’s index. Any staged version is kept. This cannot be undone by Git Desk."
msgstr "La versione nell’albero di lavoro verrà ripristinata dall’indice Git. L’eventuale versione in stage viene mantenuta. Git Desk non può annullare questa operazione."

msgid "Delete File"
msgstr "Elimina file"

msgid "Discard Changes"
msgstr "Scarta modifiche"

msgid "Ready to commit"
msgstr "Pronto per il commit"

msgid "Working tree"
msgstr "Albero di lavoro"

msgid "Merge commits require choosing an explicit mainline parent. Git Desk does not guess that parent."
msgstr "I commit di merge richiedono la scelta esplicita di un parent principale. Git Desk non prova a indovinarlo."

msgid "Switch to a normal branch with a clean working tree before applying a history action."
msgstr "Passa a un branch normale con l’albero di lavoro pulito prima di applicare un’azione della cronologia."

msgid "Finish or abort the current history operation first."
msgstr "Completa o annulla prima l’operazione di cronologia corrente."

msgid "Create a new commit on the current branch without rewriting existing history."
msgstr "Crea un nuovo commit sul branch corrente senza riscrivere la cronologia esistente."

msgid "Switch to a normal branch with a clean working tree before cherry-picking a commit."
msgstr "Passa a un branch normale con l’albero di lavoro pulito prima di eseguire il cherry-pick di un commit."

msgid "Stage changes first to amend this unpublished commit."
msgstr "Metti prima delle modifiche in stage per modificare questo commit non pubblicato."

msgid "Could Not Load Commit Message"
msgstr "Impossibile caricare il messaggio del commit"

msgid "Edit Commit Message"
msgstr "Modifica messaggio commit"

msgid "Change the message of this unpublished commit. Currently staged changes will not be included."
msgstr "Modifica il messaggio di questo commit non pubblicato. Le modifiche attualmente in stage non verranno incluse."

msgid "Save Message"
msgstr "Salva messaggio"

msgid "Commit message updated"
msgstr "Messaggio commit aggiornato"

msgid "Could Not Edit Commit"
msgstr "Impossibile modificare il commit"

msgid "Amend Unpublished Commit?"
msgstr "Modificare il commit non pubblicato?"

msgid "Add all currently staged changes to this commit? Its commit ID will change. Nothing will be pushed automatically."
msgstr "Aggiungere tutte le modifiche attualmente in stage a questo commit? Il suo ID cambierà. Nulla verrà inviato automaticamente."

msgid "Amend Commit"
msgstr "Modifica commit"

msgid "Staged changes amended into commit"
msgstr "Modifiche in stage integrate nel commit"

msgid "Could Not Amend Commit"
msgstr "Impossibile modificare il commit"

msgid "Undo Unpublished Commit?"
msgstr "Annullare il commit non pubblicato?"

msgid "Remove this commit from the branch and return its contents to the staging area? No files will be deleted. Existing staged changes remain staged."
msgstr "Rimuovere questo commit dal branch e riportarne il contenuto nello staging? Nessun file verrà eliminato. Le modifiche già in stage rimarranno tali."

msgid "Commit undone — changes returned to staging"
msgstr "Commit annullato — modifiche riportate nello staging"

msgid "Could Not Undo Commit"
msgstr "Impossibile annullare il commit"

msgid "History Operation Already in Progress"
msgstr "Operazione di cronologia già in corso"

msgid "Finish or abort the current Revert/Cherry-pick operation in Changes before starting another one."
msgstr "Completa o annulla l’operazione Revert/Cherry-pick corrente in Modifiche prima di avviarne un’altra."

msgid "Could Not Check History State"
msgstr "Impossibile verificare lo stato della cronologia"

msgid "Merge in Progress"
msgstr "Merge in corso"

msgid "Complete or abort the current merge before applying a history action."
msgstr "Completa o annulla il merge corrente prima di applicare un’azione della cronologia."

msgid "Could Not Check Merge State"
msgstr "Impossibile verificare lo stato del merge"

msgid "Could Not Read Repository Status"
msgstr "Impossibile leggere lo stato del repository"

msgid "Cannot Apply History Action Here"
msgstr "Impossibile applicare qui un’azione della cronologia"

msgid "Switch to a normal local branch with at least one commit before reverting or cherry-picking."
msgstr "Passa a un branch locale normale con almeno un commit prima di eseguire un revert o cherry-pick."

msgid "Commit or Stash Changes First"
msgstr "Esegui prima il commit o lo stash delle modifiche"

msgid "Git Desk starts Revert and Cherry-pick from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk avvia Revert e Cherry-pick da un albero di lavoro pulito. Esegui il commit del lavoro o salvalo negli Stash, quindi riprova."

msgid "Commit Is Not on the Current Branch"
msgstr "Il commit non è sul branch corrente"

msgid "Git Desk only reverts commits that are part of the current branch history. Use Cherry-pick when you want to apply a commit from another branch."
msgstr "Git Desk annulla solo i commit che fanno parte della cronologia del branch corrente. Usa Cherry-pick per applicare un commit da un altro branch."

msgid "Could Not Verify Commit Ancestry"
msgstr "Impossibile verificare l’ascendenza del commit"

msgid "Commit Is Already HEAD"
msgstr "Il commit è già HEAD"

msgid "The selected commit is already the current commit, so there is nothing to cherry-pick."
msgstr "Il commit selezionato è già quello corrente, quindi non c’è nulla su cui eseguire il cherry-pick."

msgid "Could Not Verify Current Commit"
msgstr "Impossibile verificare il commit corrente"

msgid "Revert Commit"
msgstr "Ripristina commit"

msgid "Cherry-pick Commit"
msgstr "Cherry-pick del commit"

msgid "Repository Changed"
msgstr "Repository modificato"

msgid "The current branch or working tree changed while the confirmation was open. Review the repository and try again."
msgstr "Il branch corrente o l’albero di lavoro è cambiato mentre la conferma era aperta. Controlla il repository e riprova."

msgid "Commit reverted"
msgstr "Commit ripristinato"

msgid "Commit cherry-picked"
msgstr "Commit applicato con cherry-pick"

msgid "Revert"
msgstr "Revert"

msgid "Abort Revert"
msgstr "Annulla revert"

msgid "Cherry-pick"
msgstr "Cherry-pick"

msgid "Abort Cherry-pick"
msgstr "Annulla cherry-pick"

msgid "History Action Failed"
msgstr "Azione della cronologia non riuscita"

msgid "Revert Failed"
msgstr "Revert non riuscito"

msgid "Cherry-pick Failed"
msgstr "Cherry-pick non riuscito"

msgid "History Operation Changed"
msgstr "Operazione di cronologia cambiata"

msgid "A different history operation is now active. Refresh and review Changes before continuing."
msgstr "Ora è attiva un’altra operazione di cronologia. Aggiorna e controlla Modifiche prima di continuare."

msgid "No History Operation in Progress"
msgstr "Nessuna operazione di cronologia in corso"

msgid "There is no Revert or Cherry-pick operation to continue."
msgstr "Non c’è alcuna operazione Revert o Cherry-pick da continuare."

msgid "Could Not Check Conflicts"
msgstr "Impossibile verificare i conflitti"

msgid "Conflicts Still Need Resolution"
msgstr "Ci sono ancora conflitti da risolvere"

msgid "Stage Remaining Changes"
msgstr "Metti in stage le modifiche rimanenti"

msgid "Tracked unstaged changes would not be included when the history operation continues. Stage the resolved changes first."
msgstr "Le modifiche tracciate non in stage non verrebbero incluse continuando l’operazione. Metti prima in stage le modifiche risolte."

msgid "Revert completed"
msgstr "Revert completato"

msgid "Cherry-pick completed"
msgstr "Cherry-pick completato"

msgid "Could Not Continue Revert"
msgstr "Impossibile continuare il revert"

msgid "Could Not Continue Cherry-pick"
msgstr "Impossibile continuare il cherry-pick"

msgid "A different history operation is now active. Refresh and review Changes before skipping."
msgstr "Ora è attiva un’altra operazione di cronologia. Aggiorna e controlla Modifiche prima di saltare."

msgid "No Cherry-pick in Progress"
msgstr "Nessun cherry-pick in corso"

msgid "There is no Cherry-pick operation to skip."
msgstr "Non c’è alcuna operazione Cherry-pick da saltare."

msgid "Cherry-pick Still Has Conflicts"
msgstr "Il cherry-pick ha ancora conflitti"

msgid "Skip is only offered for an empty Cherry-pick. Resolve the conflicts or abort the operation."
msgstr "Il salto è disponibile solo per un Cherry-pick vuoto. Risolvi i conflitti o annulla l’operazione."

msgid "Cherry-pick Is No Longer Empty"
msgstr "Il cherry-pick non è più vuoto"

msgid "Tracked changes are present. Review and stage the resolution to continue, or abort the Cherry-pick."
msgstr "Sono presenti modifiche tracciate. Controlla e metti in stage la risoluzione per continuare, oppure annulla il Cherry-pick."

msgid "Empty Cherry-pick skipped"
msgstr "Cherry-pick vuoto saltato"

msgid "Could Not Skip Cherry-pick"
msgstr "Impossibile saltare il cherry-pick"

msgid "Abort Current Revert?"
msgstr "Annullare il revert corrente?"

msgid "Abort Current Cherry-pick?"
msgstr "Annullare il cherry-pick corrente?"

msgid "A different history operation is now active. Refresh and review Changes before aborting."
msgstr "Ora è attiva un’altra operazione di cronologia. Aggiorna e controlla Modifiche prima di annullare."

msgid "There is no Revert or Cherry-pick operation to abort."
msgstr "Non c’è alcuna operazione Revert o Cherry-pick da annullare."

msgid "Abort Revert Failed"
msgstr "Annullamento del revert non riuscito"

msgid "Abort Cherry-pick Failed"
msgstr "Annullamento del cherry-pick non riuscito"

msgid "Could not load local commits not published to a configured remote."
msgstr "Impossibile caricare i commit locali non pubblicati su un remote configurato."

msgid "Outgoing commits unavailable"
msgstr "Commit in uscita non disponibili"

msgid "No commits yet"
msgstr "Nessun commit"

msgid "Your first commit will appear here."
msgstr "Il primo commit apparirà qui."

msgid "No changed files."
msgstr "Nessun file modificato."

msgid "Current branch · merge in progress"
msgstr "Branch corrente · merge in corso"

msgid "Current branch · history operation in progress"
msgstr "Branch corrente · operazione di cronologia in corso"

msgid "Current branch · first commit not created yet"
msgstr "Branch corrente · primo commit non ancora creato"

msgid "Current branch"
msgstr "Branch corrente"

msgid "Remote branch"
msgstr "Branch remoto"

msgid "Local branch"
msgstr "Branch locale"

msgid "Switch to Branch"
msgstr "Passa al branch"

msgid "Merge into Current Branch…"
msgstr "Unisci nel branch corrente…"

msgid "Abort Merge…"
msgstr "Interrompi merge…"

msgid "Unset Upstream"
msgstr "Rimuovi upstream"

msgid "Rename Branch…"
msgstr "Rinomina branch…"

msgid "Delete Branch…"
msgstr "Elimina branch…"

msgid "Branch actions"
msgstr "Azioni branch"

msgid "Remote branch actions"
msgstr "Azioni branch remoto"

msgid "No local branches yet"
msgstr "Nessun branch locale"

msgid "No remote branches configured"
msgstr "Nessun branch remoto configurato"

msgid "feature/my-branch"
msgstr "feature/my-branch"

msgid "New Branch"
msgstr "Nuovo branch"

msgid "Create a branch from the current branch and switch to it. Uncommitted changes stay in the working tree."
msgstr "Crea un branch dal branch corrente e passa ad esso. Le modifiche non committate restano nell’albero di lavoro."

msgid "Create & Switch"
msgstr "Crea e passa"

msgid "origin/main"
msgstr "origin/main"

msgid "Enter the remote branch this local branch should track, for example origin/main."
msgstr "Inserisci il branch remoto che questo branch locale deve seguire, ad esempio origin/main."

msgid "Set Upstream"
msgstr "Imposta upstream"

msgid "This repository has uncommitted changes. Git Desk will leave them in the working tree. Git may refuse the switch if the target branch would overwrite them."
msgstr "Questo repository contiene modifiche non committate. Git Desk le lascerà nell’albero di lavoro. Git può rifiutare il cambio se il branch di destinazione le sovrascriverebbe."

msgid "Switch Branch"
msgstr "Cambia branch"

msgid "Continue Revert"
msgstr "Continua revert"

msgid "Abort Revert…"
msgstr "Annulla revert…"

msgid "Continue Cherry-pick"
msgstr "Continua cherry-pick"

msgid "Abort Cherry-pick…"
msgstr "Annulla cherry-pick…"

msgid "Finish an empty Cherry-pick without creating a commit."
msgstr "Completa un cherry-pick vuoto senza creare un commit."

msgid "Continue the current Git history operation using the staged resolution."
msgstr "Continua l’operazione corrente della cronologia Git usando la risoluzione in stage."

msgid "Git Desk must verify the conflict state before continuing."
msgstr "Git Desk deve verificare lo stato dei conflitti prima di continuare."

msgid "Git Desk must verify the working tree state before continuing."
msgstr "Git Desk deve verificare lo stato dell’albero di lavoro prima di continuare."

msgid "Resolve and mark every conflicted file before continuing."
msgstr "Risolvi e contrassegna ogni file in conflitto prima di continuare."

msgid "There are no tracked changes to commit. Skip the empty Cherry-pick."
msgstr "Non ci sono modifiche tracciate da committare. Salta il cherry-pick vuoto."

msgid "Stage the remaining tracked changes before continuing."
msgstr "Metti in stage le modifiche tracciate rimanenti prima di continuare."

msgid "Git Desk could not verify the conflict state. Refresh the repository or abort the merge."
msgstr "Git Desk non ha potuto verificare lo stato dei conflitti. Aggiorna il repository o annulla il merge."

msgid "Conflicts are resolved, but tracked unstaged changes remain. Stage them before completing the merge."
msgstr "I conflitti sono risolti, ma restano modifiche tracciate non in stage. Mettile in stage prima di completare il merge."

msgid "All conflicts are resolved and staged. Complete the merge to create the merge commit."
msgstr "Tutti i conflitti sono risolti e in stage. Completa il merge per creare il commit di merge."

msgid "Create the merge commit using Git’s prepared merge message."
msgstr "Crea il commit di merge usando il messaggio di merge preparato da Git."

msgid "Git Desk must verify the conflict state before completing the merge."
msgstr "Git Desk deve verificare lo stato dei conflitti prima di completare il merge."

msgid "Resolve and mark every conflicted file before completing the merge."
msgstr "Risolvi e contrassegna ogni file in conflitto prima di completare il merge."

msgid "Stage the remaining tracked changes before completing the merge."
msgstr "Metti in stage le modifiche tracciate rimanenti prima di completare il merge."

msgid "No Merge in Progress"
msgstr "Nessun merge in corso"

msgid "There is no active merge to complete."
msgstr "Non c’è alcun merge attivo da completare."

msgid "Tracked unstaged changes would not be included in the merge commit. Stage them first, then complete the merge."
msgstr "Le modifiche tracciate non in stage non verrebbero incluse nel commit di merge. Mettile prima in stage, quindi completa il merge."

msgid "Merge completed"
msgstr "Merge completato"

msgid "Complete Merge Failed"
msgstr "Completamento del merge non riuscito"

msgid "Merge Already in Progress"
msgstr "Merge già in corso"

msgid "Finish the current merge or abort it before starting another one."
msgstr "Completa il merge corrente o annullalo prima di avviarne un altro."

msgid "Cannot Merge Here"
msgstr "Impossibile eseguire il merge qui"

msgid "Check out a normal local branch with at least one commit before merging another branch into it."
msgstr "Passa a un branch locale normale con almeno un commit prima di unirvi un altro branch."

msgid "Git Desk only starts a branch merge from a clean working tree. Commit your work or save it in Stashes, then try again."
msgstr "Git Desk avvia un merge di branch solo da un albero di lavoro pulito. Crea un commit o salva il lavoro negli Stash, quindi riprova."

msgid "Git will fast-forward when possible. Otherwise it will create a merge commit. If conflicts occur, Git Desk will keep the merge open so you can resolve the files in Changes or abort the merge from Branches."
msgstr "Git eseguirà un fast-forward quando possibile. In caso contrario creerà un commit di merge. Se si verificano conflitti, Git Desk manterrà il merge aperto per permetterti di risolvere i file in Modifiche o annullarlo da Branch."

msgid "Merge Branch"
msgstr "Unisci branch"

msgid "The current branch or working tree changed while the merge confirmation was open. Review the repository and try again."
msgstr "Il branch corrente o l’albero di lavoro è cambiato mentre la conferma del merge era aperta. Controlla il repository e riprova."

msgid "Merge Failed"
msgstr "Merge non riuscito"

msgid "Abort Current Merge?"
msgstr "Interrompere il merge corrente?"

msgid "Discard the changes created by the current merge attempt and restore the branch to its pre-merge state?"
msgstr "Scartare le modifiche create dal tentativo di merge corrente e ripristinare il branch allo stato precedente al merge?"

msgid "Abort Merge"
msgstr "Interrompi merge"

msgid "There is no active merge to abort."
msgstr "Non c’è alcun merge attivo da annullare."

msgid "Merge aborted"
msgstr "Merge interrotto"

msgid "Abort Merge Failed"
msgstr "Annullamento del merge non riuscito"

msgid "Rename Branch"
msgstr "Rinomina branch"

msgid "Renaming a branch changes its local name without changing its commits."
msgstr "Rinominare un branch ne modifica il nome locale senza cambiare i commit."

msgid "Rename"
msgstr "Rinomina"

msgid "This removes the local branch reference. Git Desk uses Git’s safe deletion, so Git will refuse if it considers the branch not fully merged."
msgstr "Questo rimuove il riferimento al branch locale. Git Desk usa l’eliminazione sicura di Git, quindi Git rifiuterà se considera il branch non completamente integrato."

msgid "Delete Branch"
msgstr "Elimina branch"

msgid "Type"
msgstr "Tipo"

msgid "Status"
msgstr "Stato"

msgid "Not checked out"
msgstr "Non attivo"

msgid "Not configured"
msgstr "Non configurato"

msgid "Upstream"
msgstr "Upstream"

msgid "origin"
msgstr "origin"

msgid "https://github.com/user/repository.git"
msgstr "https://github.com/user/repository.git"

msgid "Add Remote"
msgstr "Aggiungi remote"

msgid "Connect this repository to another Git repository. Enter a remote name and URL."
msgstr "Collega questo repository a un altro repository Git. Inserisci un nome remote e un URL."

msgid "Remove Remote…"
msgstr "Rimuovi remote…"

msgid "Remote actions"
msgstr "Azioni remote"

msgid "No remotes configured"
msgstr "Nessun remote configurato"

msgid "Add a remote to connect this repository to GitHub, GitLab, Codeberg, or another Git server."
msgstr "Aggiungi un remote per collegare questo repository a GitHub, GitLab, Codeberg o un altro server Git."

msgid "Remove Remote"
msgstr "Rimuovi remote"

msgid "No saved stashes"
msgstr "Nessuno stash salvato"

msgid "Loading stash…"
msgstr "Caricamento stash…"

msgid "This stash has no visible diff."
msgstr "Questo stash non ha un diff visibile."

msgid "Temporarily save staged and working-tree changes."
msgstr "Salva temporaneamente le modifiche in stage e nell’albero di lavoro."

msgid "Create the first commit before using Stash."
msgstr "Crea il primo commit prima di usare Stash."

msgid "Optional stash message"
msgstr "Messaggio stash opzionale"

msgid "Include untracked files"
msgstr "Includi file non tracciati"

msgid "Stash Changes"
msgstr "Metti modifiche in stash"

msgid "Temporarily save your current staged and working-tree changes, then return to a clean working tree."
msgstr "Salva temporaneamente le modifiche in stage e nell’albero di lavoro, quindi torna a un albero di lavoro pulito."

msgid "Stash Requires a First Commit"
msgstr "Stash richiede un primo commit"

msgid "Create the repository's first commit before using Stash."
msgstr "Crea il primo commit del repository prima di usare Stash."

msgid "Stash created"
msgstr "Stash creato"

msgid "No local changes to stash"
msgstr "Nessuna modifica locale da mettere in stash"

msgid "Stash Failed"
msgstr "Stash non riuscito"

msgid "Apply Stash Failed"
msgstr "Applicazione dello stash non riuscita"

msgid "Pop Stash?"
msgstr "Fare pop dello stash?"

msgid "Pop Stash"
msgstr "Pop stash"

msgid "Pop Stash Failed"
msgstr "Pop dello stash non riuscito"

msgid "Delete Stash?"
msgstr "Eliminare lo stash?"

msgid "Delete Stash Failed"
msgstr "Eliminazione dello stash non riuscita"

msgid "No tags"
msgstr "Nessun tag"

msgid "Annotated"
msgstr "Annotato"

msgid "Lightweight"
msgstr "Leggero"

msgid "Annotated tag"
msgstr "Tag annotato"

msgid "Lightweight tag"
msgstr "Tag leggero"

msgid "Target Commit"
msgstr "Commit destinazione"

msgid "Nothing to Tag Yet"
msgstr "Ancora nulla da taggare"

msgid "Create the first commit before creating a tag."
msgstr "Crea il primo commit prima di creare un tag."

msgid "Tag name, for example v1.0.0"
msgstr "Nome del tag, ad esempio v1.0.0"

msgid "Optional tag message"
msgstr "Messaggio tag opzionale"

msgid "Add a message for an annotated tag. Leave it blank for a lightweight tag."
